///////////////////////////////////////////////////////////////////////////////////////////////////////
// Typizer SDK для 1С:Предприятия 8.3 (платформа 8.3.17 и новее).
// Сервер: подключение к API Typizer, отправка документов на распознавание, ожидание и чтение результата.
//
// Работает в любой конфигурации: не использует БСП и объекты конфигурации. Все функции возвращают
// структуру с полями Успех и Ошибка и не вызывают исключений; ключ API не пишется в журнал и не попадает
// в тексты ошибок. Документация: https://docs.typizer.ru/how-to/1c-sdk
//
// Пример:
//  Подключение = ТипизаторAPI.НовоеПодключение(КлючAPI);
//  Параметры = ТипизаторAPI.ПараметрыПрогона();
//  Параметры.Схема = СхемаJSON;
//  Результат = ТипизаторAPI.РаспознатьФайл(Подключение, ДвоичныеДанные, "Счёт.pdf", Параметры);
//  Если Результат.Успех Тогда
//      ИНН = ТипизаторAPIКлиентСервер.ЗначениеПоля(Результат.Данные, "seller_inn");
//  Иначе
//      ВызватьИсключение Результат.Ошибка.Текст;
//  КонецЕсли;
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область Подключение

// Создаёт подключение к API Typizer. Сетевых запросов не выполняет.
//
// Параметры:
//  КлючAPI - Строка - ключ API (tz_live_…). Где хранить ключ, решает вызывающий код: SDK его не сохраняет,
//                     не пишет в журнал регистрации и не возвращает в результатах.
//  АдресСервиса - Строка - адрес API; по умолчанию https://api.typizer.ru.
//  ДополнительныеПараметры - Структура, Неопределено - см. ПараметрыПодключения().
//
// Возвращаемое значение:
//  Структура - передаётся в остальные функции модуля. Только для сервера: в ней HTTPСоединение.
//
Функция НовоеПодключение(Знач КлючAPI, Знач АдресСервиса = "", ДополнительныеПараметры = Неопределено) Экспорт
	Параметры = ПараметрыПодключения();
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Параметры, ДополнительныеПараметры);
	КонецЕсли;

	UserAgent = "Typizer-1C/" + ТипизаторAPIКлиентСервер.ВерсияSDK();
	Если Не ПустаяСтрока(Параметры.Приложение) Тогда
		UserAgent = UserAgent + " " + СокрЛП(Параметры.Приложение);
	КонецЕсли;

	Подключение = Новый Структура;
	Подключение.Вставить("АдресСервиса", ТипизаторAPIКлиентСервер.НормализованныйАдресСервиса(АдресСервиса));
	Подключение.Вставить("КлючAPI", ?(ТипЗнч(КлючAPI) = Тип("Строка"), СокрЛП(КлючAPI), ""));
	Подключение.Вставить("Соединение", Неопределено);
	Подключение.Вставить("UserAgent", UserAgent);
	Подключение.Вставить("МаксимумПовторов", Макс(1, ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Параметры.МаксимумПовторов)));
	Подключение.Вставить("Ошибка", Неопределено);

	Если ПустаяСтрока(Подключение.КлючAPI) Тогда
		Подключение.Ошибка = НоваяОшибка("api_key_missing");
		Возврат Подключение;
	КонецЕсли;
	Попытка
		Подключение.Соединение = НовоеHTTPСоединение(Подключение.АдресСервиса, Параметры);
	Исключение
		Подключение.Ошибка = НоваяОшибка("invalid_argument", 0,
			СтрШаблон(НСтр("ru = 'неверный адрес сервиса «%1»'"), Подключение.АдресСервиса));
	КонецПопытки;
	Возврат Подключение;
КонецФункции

// Дополнительные параметры подключения для НовоеПодключение().
//
// Возвращаемое значение:
//  Структура:
//   * ТаймаутСекунд - Число - таймаут одного HTTP-запроса (по умолчанию 150).
//   * Прокси - ИнтернетПрокси, Неопределено - прокси-сервер. В конфигурациях на БСП:
//              ПолучениеФайловИзИнтернета.ПолучитьПрокси("https").
//   * МаксимумПовторов - Число - сколько раз повторять запрос при ответах 429 и 503 (по умолчанию 5).
//   * Приложение - Строка - имя и версия вашей программы латиницей для заголовка User-Agent, например "MyERP/2.4".
//
Функция ПараметрыПодключения() Экспорт
	Возврат Новый Структура("ТаймаутСекунд, Прокси, МаксимумПовторов, Приложение", 150, Неопределено, 5, "");
КонецФункции

#КонецОбласти

#Область Прогоны

// Параметры распознавания для СоздатьПрогон() и РаспознатьФайл().
// Нужно указать либо Схема, либо ИдентификаторТипизатора.
//
// Возвращаемое значение:
//  Структура:
//   * Схема - Строка, Соответствие, Структура - схема извлечения (подмножество JSON Schema): текст JSON или
//             та же схема структурами 1С. Ключи вида "$defs" можно передать только в Соответствии.
//   * ИдентификаторТипизатора - Строка - сохранённый типизатор (tz_…) из личного кабинета вместо схемы.
//   * Указания - Строка - дополнительные указания для извлечения (только вместе со схемой), до 4000 символов.
//   * Режим - Строка - "standard" (по умолчанию) или "precise" — повышенная точность.
//   * Метаданные - Структура, Соответствие - ваши пары ключ/значение (строки), возвращаются с прогоном
//                  и в вебхуках. SDK добавляет source = "1c" и filename = исходное имя файла, если их нет.
//   * КлючИдемпотентности - Строка - повтор с тем же ключом в течение 24 часов не создаёт второй прогон
//                           и не списывает страницы второй раз. Пусто — SDK создаст ключ сам
//                           и вернёт его в Результат.КлючИдемпотентности.
//   * ОжиданиеСекунд - Число, Неопределено - сколько секунд (0–60) сервис держит запрос создания до
//                      завершения прогона. Неопределено: 0 в СоздатьПрогон(), 60 в РаспознатьФайл().
//   * АдресВебхука - Строка - https-адрес, на который придёт вебхук run.succeeded / run.failed.
//
Функция ПараметрыПрогона() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("Схема", Неопределено);
	Параметры.Вставить("ИдентификаторТипизатора", "");
	Параметры.Вставить("Указания", "");
	Параметры.Вставить("Режим", "");
	Параметры.Вставить("Метаданные", Неопределено);
	Параметры.Вставить("КлючИдемпотентности", "");
	Параметры.Вставить("ОжиданиеСекунд", Неопределено);
	Параметры.Вставить("АдресВебхука", "");
	Возврат Параметры;
КонецФункции

// Отправляет документ на распознавание и сразу возвращает прогон (POST /v1/extract или
// POST /v1/typizers/{id}/runs). Результат забирайте ПолучитьПрогон() или ОжидатьПрогон(). Чтобы распознать
// много файлов быстрее, сначала отправьте все, потом ждите каждый: сервис распознаёт их параллельно.
//
// Параметры:
//  Подключение - см. НовоеПодключение.
//  ДвоичныеДанные - ДвоичныеДанные - PDF, скан или фото документа, до 50 МиБ.
//  ИмяФайла - Строка - исходное имя файла, по его расширению определяется тип (можно кириллицей).
//  ПараметрыПрогона - см. ПараметрыПрогона.
//
// Возвращаемое значение:
//  см. НовыйРезультатПрогона - при Успех = Истина прогон создан; Завершен = Истина, если он уже завершился.
//
Функция СоздатьПрогон(Подключение, ДвоичныеДанные, Знач ИмяФайла, ПараметрыПрогона) Экспорт
	Результат = НовыйРезультатПрогона();
	Попытка
		Параметры = КопияПараметровПрогона(ПараметрыПрогона);
		Если ПустаяСтрока(Параметры.КлючИдемпотентности) Тогда
			Параметры.КлючИдемпотентности = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		Результат.КлючИдемпотентности = Параметры.КлючИдемпотентности;

		Результат.Ошибка = ОшибкаПодключения(Подключение);
		Если Результат.Ошибка = Неопределено Тогда
			Результат.Ошибка = ОшибкаПараметровПрогона(ДвоичныеДанные, ИмяФайла, Параметры);
		КонецЕсли;
		Если Результат.Ошибка <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;

		Ожидание = Цел(Мин(Макс(ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Параметры.ОжиданиеСекунд), 0), 60));
		Если ЗначениеЗаполнено(Параметры.ИдентификаторТипизатора) Тогда
			Путь = "/v1/typizers/" + Параметры.ИдентификаторТипизатора + "/runs";
		Иначе
			Путь = "/v1/extract";
		КонецЕсли;
		Путь = Путь + "?wait=" + Формат(Ожидание, "ЧН=0; ЧГ=0");

		Граница = "----TypizerBoundary" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
		Заголовки.Вставить("Idempotency-Key", Параметры.КлючИдемпотентности);
		Тело = ТелоMultipart(ЧастиЗапросаПрогона(ДвоичныеДанные, ИмяФайла, Параметры), Граница);

		Ответ = ВыполнитьЗапрос(Подключение, "POST", Путь, Тело, Заголовки);
		ЗаполнитьРезультатПрогона(Результат, Ответ);
	Исключение
		Результат.Ошибка = ОшибкаИсключения(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Текущее состояние прогона (GET /v1/runs/{id}).
//
// Параметры:
//  Подключение - см. НовоеПодключение.
//  ИдентификаторПрогона - Строка - run_…
//
// Возвращаемое значение:
//  см. НовыйРезультатПрогона - Успех = Истина и Завершен = Ложь, пока прогон распознаётся.
//
Функция ПолучитьПрогон(Подключение, Знач ИдентификаторПрогона) Экспорт
	Результат = НовыйРезультатПрогона();
	Попытка
		Результат.Ошибка = ОшибкаПодключения(Подключение);
		Если Результат.Ошибка = Неопределено И Не ЭтоИдентификатор(ИдентификаторПрогона) Тогда
			Результат.Ошибка = НоваяОшибка("invalid_argument", 0, НСтр("ru = 'не указан идентификатор прогона'"));
		КонецЕсли;
		Если Результат.Ошибка <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		Результат.ИдентификаторПрогона = ИдентификаторПрогона;
		Ответ = ВыполнитьЗапрос(Подключение, "GET", "/v1/runs/" + ИдентификаторПрогона);
		ЗаполнитьРезультатПрогона(Результат, Ответ);
	Исключение
		Результат.Ошибка = ОшибкаИсключения(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Ждёт завершения прогона, опрашивая сервис. Временные сбои (нет связи, 429, 5xx) не прерывают ожидание.
// Ожидание занимает сеанс — вызывайте из фонового задания (см. документацию).
//
// Параметры:
//  Подключение - см. НовоеПодключение.
//  ИдентификаторПрогона - Строка - run_…
//  ТаймаутСекунд - Число - сколько ждать (по умолчанию 900 — 15 минут).
//  ИнтервалОпросаСекунд - Число - пауза между запросами (по умолчанию 2).
//
// Возвращаемое значение:
//  см. НовыйРезультатПрогона - Успех = Истина только для успешно завершённого прогона; если время вышло,
//  Ошибка.Код = "timeout", а ИдентификаторПрогона заполнен — можно подождать ещё раз позже.
//
Функция ОжидатьПрогон(Подключение, Знач ИдентификаторПрогона, Знач ТаймаутСекунд = 900, Знач ИнтервалОпросаСекунд = 2) Экспорт
	ИнтервалОпросаСекунд = Макс(ТипизаторAPIКлиентСервер.ЧислоИзЗначения(ИнтервалОпросаСекунд), 1);
	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + Макс(ТипизаторAPIКлиентСервер.ЧислоИзЗначения(ТаймаутСекунд), 0) * 1000;
	Пока Истина Цикл
		Результат = ПолучитьПрогон(Подключение, ИдентификаторПрогона);
		Если Результат.Завершен Тогда
			Возврат Результат;
		ИначеЕсли Результат.Ошибка <> Неопределено И Не ТипизаторAPIКлиентСервер.ЭтоВременнаяОшибка(Результат.Ошибка) Тогда
			Возврат Результат;
		ИначеЕсли ТекущаяУниверсальнаяДатаВМиллисекундах() + ИнтервалОпросаСекунд * 1000 > Срок Тогда
			Результат.Успех = Ложь;
			Результат.Ошибка = НоваяОшибка("timeout", Результат.КодСостояния);
			Возврат Результат;
		КонецЕсли;
		Пауза(ИнтервалОпросаСекунд);
	КонецЦикла;
КонецФункции

// Отправляет документ и ждёт результат: СоздатьПрогон() + ОжидатьПрогон() одним вызовом.
//
// Параметры:
//  Подключение - см. НовоеПодключение.
//  ДвоичныеДанные - ДвоичныеДанные
//  ИмяФайла - Строка
//  ПараметрыПрогона - см. ПараметрыПрогона.
//  ТаймаутСекунд - Число - сколько ждать результат (по умолчанию 900 — 15 минут).
//
// Возвращаемое значение:
//  см. НовыйРезультатПрогона - при Успех = Истина в Данные результат (output), в Поля — проверки полей (fields).
//
Функция РаспознатьФайл(Подключение, ДвоичныеДанные, ИмяФайла, ПараметрыПрогона, Знач ТаймаутСекунд = 900) Экспорт
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТаймаутСекунд = Макс(ТипизаторAPIКлиентСервер.ЧислоИзЗначения(ТаймаутСекунд), 0);
	Параметры = КопияПараметровПрогона(ПараметрыПрогона);
	Если Параметры.ОжиданиеСекунд = Неопределено Тогда
		Параметры.ОжиданиеСекунд = Мин(60, ТаймаутСекунд);
	КонецЕсли;
	Создание = СоздатьПрогон(Подключение, ДвоичныеДанные, ИмяФайла, Параметры);
	Если Создание.Ошибка <> Неопределено Или Создание.Завершен Тогда
		Возврат Создание;
	КонецЕсли;
	Осталось = ТаймаутСекунд - (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
	Результат = ОжидатьПрогон(Подключение, Создание.ИдентификаторПрогона, Макс(Осталось, 0));
	Результат.КлючИдемпотентности = Создание.КлючИдемпотентности;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Аккаунт

// Кто подключён: организация и права ключа (GET /v1/me). Удобно для проверки ключа в настройках.
//
// Параметры:
//  Подключение - см. НовоеПодключение.
//
// Возвращаемое значение:
//  см. НовыйРезультат - в Данные ответ сервиса: organization.name, api_key.scopes и т. д.
//
Функция ПолучитьПрофиль(Подключение) Экспорт
	Возврат ВыполнитьПростойЗапрос(Подключение, "/v1/me");
КонецФункции

// Баланс страниц организации (GET /v1/balance, право ключа billing:read).
//
// Параметры:
//  Подключение - см. НовоеПодключение.
//
// Возвращаемое значение:
//  см. НовыйРезультат - в Данные ответ сервиса: pages_available, pages_reserved.
//
Функция ПолучитьБаланс(Подключение) Экспорт
	Возврат ВыполнитьПростойЗапрос(Подключение, "/v1/balance");
КонецФункции

#КонецОбласти

#Область НизкийУровень

// Выполняет запрос к API и разбирает ответ JSON. Повторяет запрос при 429 и 503, выдерживая Retry-After.
// Для операций, у которых нет отдельной функции в SDK.
//
// Параметры:
//  Подключение - см. НовоеПодключение.
//  Метод - Строка - "GET", "POST", "PATCH", "DELETE".
//  Путь - Строка - путь с параметрами, например "/v1/runs/run_1".
//  Тело - ДвоичныеДанные, Строка, Неопределено - строка отправляется как JSON в UTF-8.
//  ДополнительныеЗаголовки - Соответствие, Неопределено
//
// Возвращаемое значение:
//  Структура:
//   * КодСостояния - Число - код ответа; 0, если сервис недоступен.
//   * Данные - Соответствие, Массив - разобранный ответ (пустое Соответствие, если тело не JSON).
//   * ТекстОшибкиСоединения - Строка
//   * ПовторитьЧерез - Число - значение заголовка Retry-After.
//   * ИдентификаторЗапроса - Строка - X-Request-Id ответа (пригодится поддержке Typizer).
//
Функция ВыполнитьЗапрос(Подключение, Метод, Путь, Знач Тело = Неопределено, ДополнительныеЗаголовки = Неопределено) Экспорт
	Заголовки = Новый Соответствие;
	Если ТипЗнч(Тело) = Тип("Строка") Тогда
		Тело = ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Ложь);
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	КонецЕсли;
	Если ДополнительныеЗаголовки <> Неопределено Тогда
		Для Каждого Заголовок Из ДополнительныеЗаголовки Цикл
			Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
		КонецЦикла;
	КонецЕсли;
	НомерПопытки = 1;
	Пока Истина Цикл
		Ответ = ВыполнитьЗапросОдинРаз(Подключение, Метод, Путь, Тело, Заголовки);
		Повторять = (Ответ.КодСостояния = 429 Или Ответ.КодСостояния = 503) И НомерПопытки < Подключение.МаксимумПовторов;
		Если Не Повторять Тогда
			Возврат Ответ;
		КонецЕсли;
		Пауза(Мин(Макс(Ответ.ПовторитьЧерез, 1), 10));
		НомерПопытки = НомерПопытки + 1;
	КонецЦикла;
КонецФункции

// Собирает тело multipart/form-data.
//
// Параметры:
//  Части - Массив из Структура:
//   * Имя - Строка - имя поля формы.
//   * Значение - Строка, ДвоичныеДанные
//   * ИмяФайла - Строка - для файловой части.
//   * ТипСодержимого - Строка - для файловой части.
//  Граница - Строка
//
// Возвращаемое значение:
//  ДвоичныеДанные
//
Функция ТелоMultipart(Части, Граница) Экспорт
	ПС = Символы.ВК + Символы.ПС;
	Куски = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Заголовок = "--" + Граница + ПС;
		Если ТипЗнч(Часть.Значение) = Тип("ДвоичныеДанные") Тогда
			Заголовок = Заголовок + СтрШаблон("Content-Disposition: form-data; name=""%1""; filename=""%2""", Часть.Имя, Часть.ИмяФайла) + ПС
				+ "Content-Type: " + Часть.ТипСодержимого + ПС + ПС;
			Куски.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Заголовок, КодировкаТекста.UTF8, Ложь));
			Куски.Добавить(Часть.Значение);
			Куски.Добавить(ПолучитьДвоичныеДанныеИзСтроки(ПС, КодировкаТекста.UTF8, Ложь));
		Иначе
			Заголовок = Заголовок + СтрШаблон("Content-Disposition: form-data; name=""%1""", Часть.Имя) + ПС
				+ "Content-Type: text/plain; charset=utf-8" + ПС + ПС + Часть.Значение + ПС;
			Куски.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Заголовок, КодировкаТекста.UTF8, Ложь));
		КонецЕсли;
	КонецЦикла;
	Куски.Добавить(ПолучитьДвоичныеДанныеИзСтроки("--" + Граница + "--" + ПС, КодировкаТекста.UTF8, Ложь));
	Возврат СоединитьДвоичныеДанные(Куски);
КонецФункции

// Разбирает текст JSON в значения 1С: объекты — Соответствие, массивы — Массив, null — Неопределено.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Произвольный - Неопределено, если текст не JSON.
//
Функция JSONВЗначение(Текст) Экспорт
	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Значение = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Значение;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Записывает значение 1С (Структура, Соответствие, Массив, примитивы) в компактный текст JSON.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеВJSON(Значение) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

// Пауза без нагрузки на процессор. В фоновом задании ждёт на самом задании, в обычном сеансе — на
// служебном фоновом задании (ПаузаФоновогоЗадания).
//
// Параметры:
//  Секунд - Число
//
Процедура Пауза(Знач Секунд) Экспорт
	Секунд = ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Секунд);
	Если Секунд <= 0 Тогда
		Возврат;
	КонецЕсли;
	Окончание = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;
	ФоновоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если ФоновоеЗадание <> Неопределено Тогда
		Попытка
			ФоновоеЗадание.ОжидатьЗавершенияВыполнения(Секунд);
		Исключение
			// Истёк таймаут ожидания самого себя — это и есть нужная пауза; если исключение пришло раньше
			// срока, остаток дождёмся в цикле ниже.
		КонецПопытки;
	Иначе
		Попытка
			Параметры = Новый Массив;
			Параметры.Добавить(Секунд);
			Задание = ФоновыеЗадания.Выполнить("ТипизаторAPI.ПаузаФоновогоЗадания", Параметры, , "Typizer: пауза");
			Задание.ОжидатьЗавершенияВыполнения(Секунд + 5);
		Исключение
			// Фоновые задания недоступны — ниже ждём без них.
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Typizer.Пауза'"), УровеньЖурналаРегистрации.Предупреждение, , ,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Окончание Цикл
		// Досыпаем, если ожидание задания вернулось раньше срока.
		Продолжить;
	КонецЦикла;
КонецПроцедуры

// Служебная: тело фонового задания для Пауза(). Вызывать напрямую не нужно.
//
// Параметры:
//  Секунд - Число
//
Процедура ПаузаФоновогоЗадания(Секунд) Экспорт
	Пауза(Секунд);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Результаты

// Результат вызова SDK.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * КодСостояния - Число - код ответа сервиса; 0, если запроса не было или сервис недоступен.
//   * Ошибка - Неопределено, Структура - см. НоваяОшибка.
//   * Данные - Соответствие, Массив, Неопределено - полезная часть ответа.
//
Функция НовыйРезультат()
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("Ошибка", Неопределено);
	Результат.Вставить("Данные", Неопределено);
	Возврат Результат;
КонецФункции

// Результат операции с прогоном.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультат, и ещё:
//   * ИдентификаторПрогона - Строка - run_…
//   * Статус - Строка - "queued", "processing", "succeeded", "failed".
//   * Завершен - Булево - прогон завершился (успешно или с ошибкой).
//   * Данные - Соответствие, Массив, Неопределено - результат распознавания (output) по схеме.
//   * Поля - Соответствие - проверки полей (fields): путь → status/reason/sources.
//   * Прогон - Соответствие, Неопределено - весь объект прогона как его вернул сервис.
//   * КлючИдемпотентности - Строка - ключ, с которым создан прогон.
//
Функция НовыйРезультатПрогона()
	Результат = НовыйРезультат();
	Результат.Вставить("ИдентификаторПрогона", "");
	Результат.Вставить("Статус", "");
	Результат.Вставить("Завершен", Ложь);
	Результат.Вставить("Поля", Новый Соответствие);
	Результат.Вставить("Прогон", Неопределено);
	Результат.Вставить("КлючИдемпотентности", "");
	Возврат Результат;
КонецФункции

// Описание ошибки.
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка - код ошибки сервиса (insufficient_balance, document_unreadable, …) или SDK:
//           api_key_missing, invalid_argument, connection_failed, timeout, output_expired, invalid_response, client_error.
//   * Текст - Строка - понятный пользователю текст на русском.
//   * КодСостояния - Число - код ответа сервиса; 0, если ответа не было.
//   * Подробности - Строка - пояснение сервиса (detail, message) или текст ошибки соединения.
//   * ИдентификаторЗапроса - Строка - request_id для обращения в поддержку.
//
Функция НоваяОшибка(Код, КодСостояния = 0, Подробности = "", ИдентификаторЗапроса = "")
	Ошибка = Новый Структура;
	Ошибка.Вставить("Код", Код);
	Ошибка.Вставить("Текст", ТипизаторAPIКлиентСервер.ТекстОшибки(КодСостояния, Код, Подробности));
	Ошибка.Вставить("КодСостояния", КодСостояния);
	Ошибка.Вставить("Подробности", Подробности);
	Ошибка.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
	Возврат Ошибка;
КонецФункции

Функция ОшибкаОтвета(Ответ)
	Данные = ?(ТипЗнч(Ответ.Данные) = Тип("Соответствие"), Ответ.Данные, Новый Соответствие);
	Если Ответ.КодСостояния = 0 Тогда
		Возврат НоваяОшибка("connection_failed", 0, Ответ.ТекстОшибкиСоединения);
	КонецЕсли;
	Код = ТипизаторAPIКлиентСервер.СтрокаИзЗначения(Данные.Получить("code"));
	Если ПустаяСтрока(Код) Тогда
		Код = "http_" + Формат(Ответ.КодСостояния, "ЧГ=0");
	КонецЕсли;
	ИдентификаторЗапроса = ТипизаторAPIКлиентСервер.СтрокаИзЗначения(Данные.Получить("request_id"));
	Если ПустаяСтрока(ИдентификаторЗапроса) Тогда
		ИдентификаторЗапроса = Ответ.ИдентификаторЗапроса;
	КонецЕсли;
	Возврат НоваяОшибка(Код, Ответ.КодСостояния, ТипизаторAPIКлиентСервер.СтрокаИзЗначения(Данные.Получить("detail")),
		ИдентификаторЗапроса);
КонецФункции

Функция ОшибкаИсключения(Информация)
	// Тексты исключений платформы не содержат заголовков запроса, поэтому ключ API в них не попадает.
	Возврат НоваяОшибка("client_error", 0, КраткоеПредставлениеОшибки(Информация));
КонецФункции

Функция ОшибкаПодключения(Подключение)
	Если ТипЗнч(Подключение) <> Тип("Структура") Или Не Подключение.Свойство("Соединение") Тогда
		Возврат НоваяОшибка("invalid_argument", 0, НСтр("ru = 'подключение создаётся функцией ТипизаторAPI.НовоеПодключение()'"));
	КонецЕсли;
	Возврат Подключение.Ошибка;
КонецФункции

Процедура ЗаполнитьРезультатПрогона(Результат, Ответ)
	Результат.КодСостояния = Ответ.КодСостояния;
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния > 299 Тогда
		Результат.Ошибка = ОшибкаОтвета(Ответ);
		Возврат;
	КонецЕсли;
	Прогон = Ответ.Данные;
	Если ТипЗнч(Прогон) <> Тип("Соответствие") Или Прогон.Получить("id") = Неопределено Тогда
		Результат.Ошибка = НоваяОшибка("invalid_response", Ответ.КодСостояния, "", Ответ.ИдентификаторЗапроса);
		Возврат;
	КонецЕсли;
	Результат.Прогон = Прогон;
	Результат.ИдентификаторПрогона = ТипизаторAPIКлиентСервер.СтрокаИзЗначения(Прогон.Получить("id"));
	Результат.Статус = ТипизаторAPIКлиентСервер.СтрокаИзЗначения(Прогон.Получить("status"));
	Если Результат.Статус = "succeeded" Тогда
		Результат.Завершен = Истина;
		Если Прогон.Получить("output_expired") = Истина Тогда
			Результат.Ошибка = НоваяОшибка("output_expired", Ответ.КодСостояния, "", Ответ.ИдентификаторЗапроса);
			Возврат;
		КонецЕсли;
		Результат.Данные = Прогон.Получить("output");
		Поля = Прогон.Получить("fields");
		Если ТипЗнч(Поля) = Тип("Соответствие") Тогда
			Результат.Поля = Поля;
		КонецЕсли;
		Результат.Успех = Истина;
	ИначеЕсли Результат.Статус = "failed" Тогда
		Результат.Завершен = Истина;
		ОшибкаПрогона = Прогон.Получить("error");
		Код = "extraction_failed";
		Подробности = "";
		Если ТипЗнч(ОшибкаПрогона) = Тип("Соответствие") Тогда
			Код = ТипизаторAPIКлиентСервер.СтрокаИзЗначения(ОшибкаПрогона.Получить("code"));
			Подробности = ТипизаторAPIКлиентСервер.СтрокаИзЗначения(ОшибкаПрогона.Получить("message"));
		КонецЕсли;
		Результат.Ошибка = НоваяОшибка(?(ПустаяСтрока(Код), "extraction_failed", Код), Ответ.КодСостояния, Подробности,
			Ответ.ИдентификаторЗапроса);
	Иначе
		// queued, processing: прогон принят и распознаётся.
		Результат.Успех = Истина;
	КонецЕсли;
КонецПроцедуры

Функция ВыполнитьПростойЗапрос(Подключение, Путь)
	Результат = НовыйРезультат();
	Попытка
		Результат.Ошибка = ОшибкаПодключения(Подключение);
		Если Результат.Ошибка <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		Ответ = ВыполнитьЗапрос(Подключение, "GET", Путь);
		Результат.КодСостояния = Ответ.КодСостояния;
		Если Ответ.КодСостояния = 200 Тогда
			Результат.Данные = Ответ.Данные;
			Результат.Успех = Истина;
		Иначе
			Результат.Ошибка = ОшибкаОтвета(Ответ);
		КонецЕсли;
	Исключение
		Результат.Ошибка = ОшибкаИсключения(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПараметрыПрогона_

Функция КопияПараметровПрогона(ПараметрыПрогона)
	Параметры = ПараметрыПрогона();
	Если ТипЗнч(ПараметрыПрогона) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Параметры, ПараметрыПрогона);
	КонецЕсли;
	Для Каждого ИмяСтроки Из СтрРазделить("ИдентификаторТипизатора,Указания,Режим,КлючИдемпотентности,АдресВебхука", ",") Цикл
		Параметры[ИмяСтроки] = СокрЛП(ТипизаторAPIКлиентСервер.СтрокаИзЗначения(Параметры[ИмяСтроки]));
	КонецЦикла;
	Возврат Параметры;
КонецФункции

Функция ОшибкаПараметровПрогона(ДвоичныеДанные, ИмяФайла, Параметры)
	Текст = "";
	ЕстьСхема = СхемаУказана(Параметры.Схема);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Или ДвоичныеДанные.Размер() = 0 Тогда
		Текст = НСтр("ru = 'файл не передан или пуст'");
	ИначеЕсли ДвоичныеДанные.Размер() > ТипизаторAPIКлиентСервер.МаксимальныйРазмерФайла() Тогда
		Возврат НоваяОшибка("file_too_large", 0);
	ИначеЕсли ЕстьСхема И ЗначениеЗаполнено(Параметры.ИдентификаторТипизатора) Тогда
		Текст = НСтр("ru = 'укажите либо схему, либо идентификатор типизатора, но не оба сразу'");
	ИначеЕсли Не ЕстьСхема И Не ЗначениеЗаполнено(Параметры.ИдентификаторТипизатора) Тогда
		Текст = НСтр("ru = 'не указана схема извлечения или идентификатор типизатора'");
	ИначеЕсли ЕстьСхема И ТипЗнч(Параметры.Схема) <> Тип("Строка") И ТипЗнч(Параметры.Схема) <> Тип("Соответствие")
		И ТипЗнч(Параметры.Схема) <> Тип("Структура") Тогда
		Текст = НСтр("ru = 'схема передаётся строкой JSON, Соответствием или Структурой'");
	ИначеЕсли ЗначениеЗаполнено(Параметры.ИдентификаторТипизатора) И Не ЭтоИдентификатор(Параметры.ИдентификаторТипизатора) Тогда
		Текст = НСтр("ru = 'неверный идентификатор типизатора'");
	ИначеЕсли ЗначениеЗаполнено(Параметры.ИдентификаторТипизатора) И ЗначениеЗаполнено(Параметры.Указания) Тогда
		Текст = НСтр("ru = 'указания передаются только вместе со схемой: у типизатора они уже сохранены'");
	ИначеЕсли ЗначениеЗаполнено(Параметры.Режим) И Параметры.Режим <> "standard" И Параметры.Режим <> "precise" Тогда
		Текст = НСтр("ru = 'режим — ""standard"" или ""precise""'");
	ИначеЕсли Параметры.Метаданные <> Неопределено И ТипЗнч(Параметры.Метаданные) <> Тип("Структура")
		И ТипЗнч(Параметры.Метаданные) <> Тип("Соответствие") Тогда
		Текст = НСтр("ru = 'метаданные передаются Структурой или Соответствием'");
	ИначеЕсли Не ЭтоПечатныйASCII(Параметры.КлючИдемпотентности) Или СтрДлина(Параметры.КлючИдемпотентности) > 255 Тогда
		Текст = НСтр("ru = 'ключ идемпотентности — от 1 до 255 печатных символов латиницей'");
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НоваяОшибка("invalid_argument", 0, Текст);
КонецФункции

Функция СхемаУказана(Схема)
	Если Схема = Неопределено Или Схема = Null Тогда
		Возврат Ложь;
	ИначеЕсли ТипЗнч(Схема) = Тип("Строка") Тогда
		Возврат Не ПустаяСтрока(Схема);
	ИначеЕсли ТипЗнч(Схема) = Тип("Структура") Или ТипЗнч(Схема) = Тип("Соответствие") Тогда
		Возврат Схема.Количество() > 0;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ЧастиЗапросаПрогона(ДвоичныеДанные, ИмяФайла, Параметры)
	// Имя файла в теле запроса — латиницей (document.pdf): исходное, возможно кириллическое, имя уходит в metadata.filename.
	Расширение = ASCIIРасширение(ИмяФайла);
	ИмяВЗапросе = "document" + ?(ПустаяСтрока(Расширение), "", "." + Расширение);

	Метаданные_ = Новый Соответствие;
	Метаданные_.Вставить("source", "1c");
	Метаданные_.Вставить("filename", Лев(ТипизаторAPIКлиентСервер.СтрокаИзЗначения(ИмяФайла), 500));
	Если Параметры.Метаданные <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Параметры.Метаданные Цикл
			Метаданные_.Вставить(Строка(КлючИЗначение.Ключ), ТипизаторAPIКлиентСервер.СтрокаИзЗначения(КлючИЗначение.Значение));
		КонецЦикла;
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(Новый Структура("Имя, Значение, ИмяФайла, ТипСодержимого",
		"file", ДвоичныеДанные, ИмяВЗапросе, ТипизаторAPIКлиентСервер.ТипСодержимогоФайла(ИмяВЗапросе)));
	Если СхемаУказана(Параметры.Схема) Тогда
		Схема = ?(ТипЗнч(Параметры.Схема) = Тип("Строка"), СокрЛП(Параметры.Схема), ЗначениеВJSON(Параметры.Схема));
		Части.Добавить(Новый Структура("Имя, Значение", "schema", Схема));
		Если ЗначениеЗаполнено(Параметры.Указания) Тогда
			Части.Добавить(Новый Структура("Имя, Значение", "instructions", Параметры.Указания));
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.Режим) Тогда
		Части.Добавить(Новый Структура("Имя, Значение", "mode", Параметры.Режим));
	КонецЕсли;
	Части.Добавить(Новый Структура("Имя, Значение", "metadata", ЗначениеВJSON(Метаданные_)));
	Если ЗначениеЗаполнено(Параметры.АдресВебхука) Тогда
		Части.Добавить(Новый Структура("Имя, Значение", "webhook_url", Параметры.АдресВебхука));
	КонецЕсли;
	Возврат Части;
КонецФункции

Функция ASCIIРасширение(ИмяФайла)
	Расширение = ТипизаторAPIКлиентСервер.РасширениеФайла(ТипизаторAPIКлиентСервер.СтрокаИзЗначения(ИмяФайла));
	Для Позиция = 1 По СтрДлина(Расширение) Цикл
		Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789", Сред(Расширение, Позиция, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат Лев(Расширение, 10);
КонецФункции

// Идентификатор Typizer (run_…, tz_…): латиница, цифры, «_» и «-» — его можно подставить в путь запроса.
Функция ЭтоИдентификатор(Значение)
	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Или СтрДлина(Значение) > 64 Тогда
		Возврат Ложь;
	КонецЕсли;
	Допустимые = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-";
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(Допустимые, Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЭтоПечатныйASCII(Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Позиция);
		Если Код < 32 Или Код > 126 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

#КонецОбласти

#Область HTTP

Функция НовоеHTTPСоединение(АдресСервиса, Параметры)
	Защищенное = СтрНачинаетсяС(НРег(АдресСервиса), "https://");
	ХостИПорт = Сред(АдресСервиса, ?(Защищенное, 9, 8));
	Если СтрНайти(ХостИПорт, "/") > 0 Тогда
		ХостИПорт = Лев(ХостИПорт, СтрНайти(ХостИПорт, "/") - 1);
	КонецЕсли;
	Порт = ?(Защищенное, 443, 80);
	Хост = ХостИПорт;
	Если СтрНайти(ХостИПорт, ":") > 0 Тогда
		Хост = Лев(ХостИПорт, СтрНайти(ХостИПорт, ":") - 1);
		Порт = ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Сред(ХостИПорт, СтрНайти(ХостИПорт, ":") + 1));
	КонецЕсли;
	Если ПустаяСтрока(Хост) Или Порт <= 0 Тогда
		ВызватьИсключение НСтр("ru = 'Неверный адрес сервиса'");
	КонецЕсли;

	ЗащищенноеСоединение = Неопределено;
	Если Защищенное Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС);
	КонецЕсли;
	Прокси = ?(ТипЗнч(Параметры.Прокси) = Тип("ИнтернетПрокси"), Параметры.Прокси, Неопределено);
	Таймаут = Макс(ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Параметры.ТаймаутСекунд), 0);
	Возврат Новый HTTPСоединение(Хост, Порт, , , Прокси, Таймаут, ЗащищенноеСоединение);
КонецФункции

Функция ВыполнитьЗапросОдинРаз(Подключение, Метод, Путь, Тело, ДополнительныеЗаголовки)
	Ответ = Новый Структура("КодСостояния, Данные, ТекстОшибкиСоединения, ПовторитьЧерез, ИдентификаторЗапроса",
		0, Новый Соответствие, "", 0, "");
	Если Подключение.Соединение = Неопределено Тогда
		Ответ.ТекстОшибкиСоединения = НСтр("ru = 'Подключение не создано'");
		Возврат Ответ;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Подключение.КлючAPI);
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("User-Agent", Подключение.UserAgent);
	Для Каждого Заголовок Из ДополнительныеЗаголовки Цикл
		Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Если Тело <> Неопределено Тогда
		Запрос.УстановитьТелоИзДвоичныхДанных(Тело);
	КонецЕсли;

	Попытка
		HTTPОтвет = Подключение.Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		// Текст исключения не содержит заголовков запроса — ключ API в журнал не попадает.
		Ответ.ТекстОшибкиСоединения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Typizer.Соединение'"), УровеньЖурналаРегистрации.Ошибка, , ,
			Метод + " " + Лев(Путь, СтрНайти(Путь + "?", "?") - 1) + ": " + Ответ.ТекстОшибкиСоединения);
		Возврат Ответ;
	КонецПопытки;

	Ответ.КодСостояния = HTTPОтвет.КодСостояния;
	Ответ.ПовторитьЧерез = ТипизаторAPIКлиентСервер.ЧислоИзЗначения(ЗаголовокОтвета(HTTPОтвет, "retry-after"));
	Ответ.ИдентификаторЗапроса = ТипизаторAPIКлиентСервер.СтрокаИзЗначения(ЗаголовокОтвета(HTTPОтвет, "x-request-id"));

	Данные = JSONВЗначение(HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Если ТипЗнч(Данные) = Тип("Соответствие") Или ТипЗнч(Данные) = Тип("Массив") Тогда
		Ответ.Данные = Данные;
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Функция ЗаголовокОтвета(HTTPОтвет, ИмяВНижнемРегистре)
	Для Каждого Заголовок Из HTTPОтвет.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = ИмяВНижнемРегистре Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#КонецОбласти
