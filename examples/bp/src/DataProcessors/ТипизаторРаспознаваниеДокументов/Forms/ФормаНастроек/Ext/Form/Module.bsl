#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Настройки = ТипизаторСервер.Настройки();
	КлючСохранен = Настройки.КлючЗадан;
	АдресСервиса = Настройки.АдресСервиса;
	ТочныйРежим = Настройки.ТочныйРежим;
	Организация = Настройки.Организация;
	Склад = Настройки.Склад;
	ВидДокумента = Настройки.ВидДокумента;
	ПрикреплятьФайл = Настройки.ПрикреплятьФайл;
	СоздаватьСчетФактуру = Настройки.СоздаватьСчетФактуру;
	ЕстьПравоАдминистрирования = ТипизаторСервер.ЕстьПравоАдминистрирования();

	Для Каждого Вид Из ТипизаторКлиентСервер.ВидыДокументов() Цикл
		Элементы.ВидДокумента.СписокВыбора.Добавить(Вид.Значение, Вид.Представление);
	КонецЦикла;

	Элементы.КлючAPI.ПодсказкаВвода = ?(КлючСохранен,
		НСтр("ru = 'Ключ сохранён. Чтобы заменить — вставьте новый'"),
		НСтр("ru = 'Вставьте ключ вида tz_live_…'"));
	Элементы.КлючAPI.ТолькоПросмотр = Не ЕстьПравоАдминистрирования;
	Элементы.АдресСервиса.ТолькоПросмотр = Не ЕстьПравоАдминистрирования;
	Элементы.ТочныйРежим.ТолькоПросмотр = Не ЕстьПравоАдминистрирования;
	Элементы.ДекорацияТолькоАдминистратор.Видимость = Не ЕстьПравоАдминистрирования;
	Элементы.ДекорацияПолучитьКлюч.Заголовок = Новый ФорматированнаяСтрока(
		НСтр("ru = 'Ключ API создаётся в личном кабинете: '"),
		Новый ФорматированнаяСтрока(НСтр("ru = 'my.typizer.ru → Ключи API'"), , , , ТипизаторAPIКлиентСервер.АдресЛичногоКабинета()),
		НСтр("ru = '. Ключ хранится в защищённом хранилище 1С и не показывается пользователям.'"));
	Элементы.ДекорацияВерсия.Заголовок = СтрШаблон(НСтр("ru = 'Расширение Typizer для 1С, версия %1'"), ТипизаторКлиентСервер.ВерсияРасширения());
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	Результат = ПроверитьПодключениеНаСервере(КлючAPI, АдресСервиса);
	РезультатПроверки = Результат.Текст;
	Элементы.РезультатПроверки.ЦветТекста = ?(Результат.Успех, WebЦвета.ЗеленыйЛес, WebЦвета.Красный);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	ЗаписатьНаСервере();
	Закрыть(Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПроверитьПодключениеНаСервере(КлючAPI, АдресСервиса)
	Возврат ТипизаторСервер.ПроверитьПодключение(СокрЛП(КлючAPI), АдресСервиса);
КонецФункции

&НаСервере
Процедура ЗаписатьНаСервере()
	Настройки = Новый Структура("АдресСервиса, ТочныйРежим, Организация, Склад, ВидДокумента, ПрикреплятьФайл, СоздаватьСчетФактуру");
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект);
	НовыйКлюч = ?(ПустаяСтрока(КлючAPI), Неопределено, СокрЛП(КлючAPI));
	ТипизаторСервер.ЗаписатьНастройки(Настройки, НовыйКлюч);
	КлючAPI = "";
	КлючСохранен = КлючСохранен Или НовыйКлюч <> Неопределено;
КонецПроцедуры

#КонецОбласти
