#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не Параметры.Свойство("Строки") Или ТипЗнч(Параметры.Строки) <> Тип("Массив") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Для Каждого Описание Из Параметры.Строки Цикл
		НоваяСтрока = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Описание);
		НоваяСтрока.Запомнить = Истина;
		НоваяСтрока.Создать = Не ЗначениеЗаполнено(НоваяСтрока.Номенклатура);
		НоваяСтрока.ВидСтроки = ?(НоваяСтрока.ЭтоУслуга, НСтр("ru = 'Услуга'"), НСтр("ru = 'Товар'"));
	КонецЦикла;
	Элементы.ДекорацияПояснение.Заголовок = СтрШаблон(
		НСтр("ru = 'Этих позиций (%1) нет в справочнике «Номенклатура». Выберите подходящую позицию — Typizer запомнит выбор для этого поставщика и в следующий раз подставит её сам. Если оставить поле пустым, будет создана новая номенклатура.'"),
		Строки.Количество());
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтроки

&НаКлиенте
Процедура СтрокиНоменклатураПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Строки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Создать = Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Готово(Команда)
	Результат = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) И Не Строка.Создать Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Выберите номенклатуру для «%1» или отметьте «Создать новую».'"), Строка.Наименование), ,
				"Строки[" + Формат(Строки.Индекс(Строка), "ЧН=0; ЧГ=0") + "].Номенклатура");
			Возврат;
		КонецЕсли;
		Описание = Новый Структура("ИННПоставщика, Поставщик, КлючСтроки, Наименование, Артикул, Единица, КодЕдиницы, ЭтоУслуга, СтавкаНДС,
			|Номенклатура, Запомнить, Создать");
		ЗаполнитьЗначенияСвойств(Описание, Строка);
		Результат.Добавить(Описание);
	КонецЦикла;
	Закрыть(Результат);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовуюДляВсехПустых(Команда)
	Для Каждого Строка Из Строки Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Строка.Создать = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
