#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Настройки = ТипизаторСервер.Настройки();
	КлючЗадан = Настройки.КлючЗадан;
	Организация = Настройки.Организация;
	Склад = Настройки.Склад;
	ПрикреплятьФайл = Настройки.ПрикреплятьФайл;
	СоздаватьСчетФактуру = Настройки.СоздаватьСчетФактуру;
	ВидДокумента = Настройки.ВидДокумента;
	Если Параметры.Свойство("ВидДокумента") И ЗначениеЗаполнено(Параметры.ВидДокумента) Тогда
		ВидДокумента = Параметры.ВидДокумента;
	КонецЕсли;

	Для Каждого Вид Из ТипизаторКлиентСервер.ВидыДокументов() Цикл
		Элементы.ВидДокумента.СписокВыбора.Добавить(Вид.Значение, Вид.Представление);
	КонецЦикла;
	Если Элементы.ВидДокумента.СписокВыбора.НайтиПоЗначению(ВидДокумента) = Неопределено Тогда
		ВидДокумента = ТипизаторКлиентСервер.ВидАвтоопределение();
	КонецЕсли;

	УстановитьУсловноеОформление();
	ОбновитьДоступность(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не КлючЗадан Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОНастройке", ЭтотОбъект),
			НСтр("ru = 'Чтобы распознавать документы, подключите Typizer: один раз укажите ключ API из личного кабинета my.typizer.ru. Открыть настройки?'"),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, НСтр("ru = 'Typizer'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ИдетРаспознавание Тогда
		Отказ = Истина;
		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = НСтр("ru = 'Идёт распознавание документов.'");
			Возврат;
		КонецЕсли;
		ПоказатьПредупреждение(, НСтр("ru = 'Дождитесь окончания распознавания: оно займёт не больше пары минут.'"));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидДокументаОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВидДокумента = ТипизаторКлиентСервер.ВидАвтоопределение();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументы

&НаКлиенте
Процедура ДокументыПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
КонецПроцедуры

&НаКлиенте
Процедура ДокументыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	Значения = ПараметрыПеретаскивания.Значение;
	Если ТипЗнч(Значения) <> Тип("Массив") Тогда
		Значения = ОбщегоНазначенияКлиентСерверМассив(Значения);
	КонецЕсли;
	Описания = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		ПолноеИмя = ПолноеИмяПеретаскиваемогоФайла(Значение);
		Если Не ПустаяСтрока(ПолноеИмя) Тогда
			Описания.Добавить(Новый ОписаниеПередаваемогоФайла(ПолноеИмя));
		КонецЕсли;
	КонецЦикла;
	Если Описания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	НачатьПомещениеФайлов(Новый ОписаниеОповещения("ПослеПомещенияФайлов", ЭтотОбъект), Описания, , Ложь, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ДокументыПриАктивизацииСтроки(Элемент)
	ОтключитьОбработчикОжидания("ОбновитьПоляТекущегоДокумента");
	ПодключитьОбработчикОжидания("ОбновитьПоляТекущегоДокумента", 0.2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = Документы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеСтроки.СозданныйДокумент) Тогда
		ПоказатьЗначение(, ДанныеСтроки.СозданныйДокумент);
	ИначеЕсли ДанныеСтроки.Статус = ТипизаторКлиентСервер.СтатусОшибка() Тогда
		ПоказатьПредупреждение(, ДанныеСтроки.ТекстОшибки, , ДанныеСтроки.ИмяФайла);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДокументыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	ДобавитьФайлы(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ДокументыПередУдалением(Элемент, Отказ)
	Если ИдетРаспознавание Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьФайлы(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru = 'Выберите сканы или PDF документов поставщиков'");
	Диалог.МножественныйВыбор = Истина;
	Диалог.Фильтр = ТипизаторКлиентСервер.ФильтрДиалогаВыбораФайлов();
	НачатьПомещениеФайлов(Новый ОписаниеОповещения("ПослеПомещенияФайлов", ЭтотОбъект), , Диалог, Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура Распознать(Команда)
	НачатьРаспознавание();
КонецПроцедуры

&НаКлиенте
Процедура Повторить(Команда)
	Для Каждого ИдентификаторСтроки Из Элементы.Документы.ВыделенныеСтроки Цикл
		ДанныеСтроки = Документы.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ДанныеСтроки <> Неопределено И ДанныеСтроки.Статус = ТипизаторКлиентСервер.СтатусОшибка() Тогда
			ПодготовитьСтрокуКПовтору(ДанныеСтроки);
		КонецЕсли;
	КонецЦикла;
	НачатьРаспознавание();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументы(Команда)
	Идентификаторы = Новый Массив;
	Для Каждого Строка Из Документы Цикл
		Если Строка.Пометка И ТипизаторКлиентСервер.МожноСоздатьДокумент(Строка.Статус) И Не ЗначениеЗаполнено(Строка.СозданныйДокумент) Тогда
			Идентификаторы.Добавить(Строка.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте флажками распознанные документы со статусом «Готово» или «Требует проверки».'"));
		Возврат;
	КонецЕсли;

	Подготовка = ПодготовитьСозданиеНаСервере(Идентификаторы);
	Контекст = Новый Структура;
	Контекст.Вставить("Идентификаторы", Подготовка.Идентификаторы);
	Контекст.Вставить("Подготовка", Подготовка);
	Контекст.Вставить("СоздаватьКонтрагентов", Ложь);
	Контекст.Вставить("Сопоставление", Подготовка.Сопоставление);
	Если Контекст.Идентификаторы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Эти документы уже есть в базе — повторно не создаём. Ссылки на них в колонке «Документ 1С».'"));
		Возврат;
	КонецЕсли;

	Если Подготовка.НовыеКонтрагенты.Количество() > 0 Тогда
		Список = Новый Массив;
		Для Каждого Контрагент Из Подготовка.НовыеКонтрагенты Цикл
			Список.Добавить(СтрШаблон(НСтр("ru = '• %1, ИНН %2'"), Контрагент.Наименование, Контрагент.ИНН));
		КонецЦикла;
		Текст = СтрШаблон(НСтр("ru = 'В справочнике «Контрагенты» нет поставщиков:
			|%1
			|
			|Создать их по данным из документов? Реквизиты можно будет дополнить по ИНН в карточке контрагента.'"),
			СтрСоединить(Список, Символы.ПС));
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОКонтрагентах", ЭтотОбъект, Контекст), Текст,
			РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да, НСтр("ru = 'Новые контрагенты'"));
		Возврат;
	КонецЕсли;
	СопоставитьНоменклатуру(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)
	ТипизаторКлиент.ОткрытьНастройки(ЭтотОбъект, Новый ОписаниеОповещения("ПослеЗакрытияНастроек", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	Для Каждого Строка Из Документы Цикл
		Строка.Пометка = ТипизаторКлиентСервер.МожноСоздатьДокумент(Строка.Статус) И Не ЗначениеЗаполнено(Строка.СозданныйДокумент);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)
	Для Каждого Строка Из Документы Цикл
		Строка.Пометка = Ложь;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ДобавлениеФайлов

&НаКлиенте
Процедура ПослеПомещенияФайлов(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт
	Если ПомещенныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Пропущенные = Новый Массив;
	Для Каждого Файл Из ПомещенныеФайлы Цикл
		ИмяФайла = ТипизаторКлиентСервер.ИмяФайлаБезКаталога(Файл.Имя);
		Если Не ТипизаторКлиентСервер.ФайлПоддерживается(ИмяФайла) Тогда
			Пропущенные.Добавить(ИмяФайла);
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Документы.Добавить();
		НоваяСтрока.Идентификатор = Строка(Новый УникальныйИдентификатор);
		НоваяСтрока.КлючИдемпотентности = Строка(Новый УникальныйИдентификатор);
		НоваяСтрока.ИмяФайла = ИмяФайла;
		НоваяСтрока.АдресФайла = Файл.Хранение;
		УстановитьСтатус(НоваяСтрока, ТипизаторКлиентСервер.СтатусОжидает());
	КонецЦикла;
	Если Пропущенные.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Пропущены файлы, которые Typizer не распознаёт: %1. Подходят PDF, JPG, PNG, TIFF, BMP и WEBP.'"),
			СтрСоединить(Пропущенные, ", ")));
	КонецЕсли;
	ОбновитьДоступность(ЭтотОбъект);
	НачатьРаспознавание();
КонецПроцедуры

&НаКлиенте
Функция ПолноеИмяПеретаскиваемогоФайла(Значение)
	Если ТипЗнч(Значение) = Тип("Файл") Тогда
		Возврат Значение.ПолноеИмя;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";
КонецФункции

&НаКлиенте
Функция ОбщегоНазначенияКлиентСерверМассив(Значение)
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Распознавание

&НаКлиенте
Процедура НачатьРаспознавание()
	Если ИдетРаспознавание Тогда
		Возврат;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Для Каждого Строка Из Документы Цикл
		Если Строка.Статус = ТипизаторКлиентСервер.СтатусОжидает() Тогда
			Идентификаторы.Добавить(Строка.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Не КлючЗадан Тогда
		ПослеВопросаОНастройке(КодВозвратаДиалога.Да, Неопределено);
		Возврат;
	КонецЕсли;

	ДлительнаяОперация = НачатьРаспознаваниеНаСервере(Идентификаторы);
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИдетРаспознавание = Истина;
	ПроцентВыполнения = 0;
	ТекстПрогресса = НСтр("ru = 'Документы отправлены в Typizer, идёт распознавание…'");
	ОбновитьДоступность(ЭтотОбъект);

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ПриПрогрессеРаспознавания", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация,
		Новый ОписаниеОповещения("ПриЗавершенииРаспознавания", ЭтотОбъект), ПараметрыОжидания);
КонецПроцедуры

&НаСервере
Функция НачатьРаспознаваниеНаСервере(Идентификаторы)
	Файлы = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Строка = НайтиСтроку(Идентификатор);
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(Строка.АдресФайла);
		Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
			Строка.ТекстОшибки = НСтр("ru = 'Файл больше не доступен. Добавьте его ещё раз.'");
			УстановитьСтатус(Строка, ТипизаторКлиентСервер.СтатусОшибка());
			Продолжить;
		КонецЕсли;
		Если ДвоичныеДанные.Размер() > ТипизаторКлиентСервер.МаксимальныйРазмерФайла() Тогда
			Строка.ТекстОшибки = ТипизаторКлиентСервер.ТекстОшибкиСервиса(413);
			УстановитьСтатус(Строка, ТипизаторКлиентСервер.СтатусОшибка());
			Продолжить;
		КонецЕсли;
		Файл = Новый Структура;
		Файл.Вставить("Идентификатор", Строка.Идентификатор);
		Файл.Вставить("ИмяФайла", Строка.ИмяФайла);
		Файл.Вставить("ДвоичныеДанные", ДвоичныеДанные);
		Файл.Вставить("КлючИдемпотентности", Строка.КлючИдемпотентности);
		Файлы.Добавить(Файл);
		УстановитьСтатус(Строка, ТипизаторКлиентСервер.СтатусРаспознаётся());
	КонецЦикла;
	Если Файлы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыПроцедуры = Новый Структура("Файлы, ВидДокумента", Файлы, ВидДокумента);
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Typizer: распознавание документов'");
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне("ТипизаторСервер.РаспознатьДокументы", ПараметрыПроцедуры, ПараметрыВыполнения);
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	Возврат ДлительнаяОперация;
КонецФункции

&НаКлиенте
Процедура ПриПрогрессеРаспознавания(Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.Свойство("Прогресс") Или Результат.Прогресс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Прогресс = Результат.Прогресс;
	Если Прогресс.Свойство("Процент") И Прогресс.Процент <> Неопределено Тогда
		ПроцентВыполнения = Прогресс.Процент;
	КонецЕсли;
	Если Прогресс.Свойство("Текст") И ЗначениеЗаполнено(Прогресс.Текст) Тогда
		ТекстПрогресса = Прогресс.Текст;
	КонецЕсли;
	Если Прогресс.Свойство("ДополнительныеПараметры") И ТипЗнч(Прогресс.ДополнительныеПараметры) = Тип("Структура")
		И Прогресс.ДополнительныеПараметры.Свойство("Результат") Тогда
		Результаты = Новый Массив;
		Результаты.Добавить(Прогресс.ДополнительныеПараметры.Результат);
		ПрименитьРезультаты(Результаты);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗавершенииРаспознавания(Результат, ДополнительныеПараметры) Экспорт
	ИдетРаспознавание = Ложь;
	Если Результат = Неопределено Тогда
		ОтметитьНезавершенные(НСтр("ru = 'Распознавание отменено.'"));
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ОтметитьНезавершенные(Результат.КраткоеПредставлениеОшибки);
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		ПрименитьРезультатыИзХранилища(Результат.АдресРезультата);
	КонецЕсли;
	ПроцентВыполнения = 100;
	ТекстПрогресса = ИтогРаспознавания();
	ОбновитьДоступность(ЭтотОбъект);
	ОбновитьПоляТекущегоДокумента();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Typizer'"), , ТекстПрогресса);

	// Файлы, добавленные во время распознавания, отправляем следом.
	НачатьРаспознавание();
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьНезавершенные(ТекстОшибки)
	Для Каждого Строка Из Документы Цикл
		Если Строка.Статус = ТипизаторКлиентСервер.СтатусРаспознаётся() Тогда
			Строка.ТекстОшибки = ТекстОшибки;
			УстановитьСтатус(Строка, ТипизаторКлиентСервер.СтатусОшибка());
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПрименитьРезультатыИзХранилища(АдресРезультата)
	Результаты = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Результаты) = Тип("Массив") Тогда
		ПрименитьРезультатыНаСервере(Результаты);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПрименитьРезультаты(Результаты)
	ПрименитьРезультатыНаСервере(Результаты);
КонецПроцедуры

&НаСервере
Процедура ПрименитьРезультатыНаСервере(Результаты)
	Для Каждого Результат Из Результаты Цикл
		Строка = НайтиСтроку(Результат.Идентификатор);
		Если Строка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строка.ИдентификаторПрогона = Результат.ИдентификаторПрогона;
		Строка.ТекстОшибки = Результат.ТекстОшибки;
		Если Результат.Документ <> Неопределено Тогда
			Документ = Результат.Документ;
			Строка.АдресРезультата = ПоместитьВоВременноеХранилище(Документ, УникальныйИдентификатор);
			Строка.ВидДокументаПредставление = Документ.ПредставлениеВида;
			Строка.Номер = Документ.Номер;
			Строка.Дата = Документ.Дата;
			Строка.Контрагент = СокрЛП(Документ.Продавец.Наименование
				+ ?(ПустаяСтрока(Документ.Продавец.ИНН), "", ", ИНН " + Документ.Продавец.ИНН));
			Строка.Сумма = Документ.Итого;
			Поля = Новый Массив;
			Для Каждого Поле Из Документ.ПоляНаПроверку Цикл
				Поля.Добавить(Поле.Поле);
			КонецЦикла;
			Строка.НаПроверку = СтрСоединить(Поля, ", ");
		КонецЕсли;
		УстановитьСтатус(Строка, Результат.Статус);
		Строка.Пометка = ТипизаторКлиентСервер.МожноСоздатьДокумент(Строка.Статус);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ИтогРаспознавания()
	Готово = 0;
	НаПроверку = 0;
	Ошибок = 0;
	Для Каждого Строка Из Документы Цикл
		Если Строка.Статус = ТипизаторКлиентСервер.СтатусГотово() Тогда
			Готово = Готово + 1;
		ИначеЕсли Строка.Статус = ТипизаторКлиентСервер.СтатусТребуетПроверки() Тогда
			НаПроверку = НаПроверку + 1;
		ИначеЕсли Строка.Статус = ТипизаторКлиентСервер.СтатусОшибка() Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	Текст = СтрШаблон(НСтр("ru = 'Готово: %1, требуют проверки: %2'"), Готово, НаПроверку);
	Если Ошибок > 0 Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = ', с ошибками: %1'"), Ошибок);
	КонецЕсли;
	Возврат Текст;
КонецФункции

&НаКлиенте
Процедура ПодготовитьСтрокуКПовтору(ДанныеСтроки)
	// Если сервис не успел ответить, повторяем с тем же ключом: прогон не создастся второй раз и страницы не спишутся дважды.
	// После ошибки самого распознавания нужен новый прогон — и новый ключ.
	Если Не ДанныеСтроки.ОжиданиеПрервано Тогда
		ДанныеСтроки.КлючИдемпотентности = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	ДанныеСтроки.ТекстОшибки = "";
	УстановитьСтатус(ДанныеСтроки, ТипизаторКлиентСервер.СтатусОжидает());
КонецПроцедуры

#КонецОбласти

#Область СозданиеДокументов

&НаСервере
Функция ПодготовитьСозданиеНаСервере(Идентификаторы)
	Задания = ЗаданияНаСоздание(Идентификаторы);
	Подготовка = ТипизаторСозданиеДокументов.ПодготовитьСоздание(Задания);

	Результат = Новый Структура;
	Результат.Вставить("НовыеКонтрагенты", Подготовка.НовыеКонтрагенты);
	Результат.Вставить("Идентификаторы", Новый Массив);
	Результат.Вставить("Несопоставленные", Новый Массив);
	Результат.Вставить("Сопоставление", Новый Массив);
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Дубль = Подготовка.Дубли.Получить(Идентификатор);
		Если Дубль = Неопределено Тогда
			Результат.Идентификаторы.Добавить(Идентификатор);
			Продолжить;
		КонецЕсли;
		Строка = НайтиСтроку(Идентификатор);
		Строка.СозданныйДокумент = Дубль;
		Строка.Пометка = Ложь;
		Строка.Предупреждения = НСтр("ru = 'Такой документ уже есть в базе — повторно не создан.'");
	КонецЦикла;
	Для Каждого СтрокаНоменклатуры Из Подготовка.Строки Цикл
		Если СтрокаНоменклатуры.Найдено Тогда
			СтрокаНоменклатуры.Вставить("Запомнить", Ложь);
			СтрокаНоменклатуры.Вставить("Создать", Ложь);
			Результат.Сопоставление.Добавить(СтрокаНоменклатуры);
		Иначе
			Результат.Несопоставленные.Добавить(СтрокаНоменклатуры);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура СопоставитьНоменклатуру(Контекст)
	Если Контекст.Подготовка.Несопоставленные.Количество() = 0 Тогда
		СоздатьДокументыЗавершение(Контекст);
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Обработка.ТипизаторРаспознаваниеДокументов.Форма.ФормаСопоставления",
		Новый Структура("Строки", Контекст.Подготовка.Несопоставленные), ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ПослеСопоставленияНоменклатуры", ЭтотОбъект, Контекст),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОКонтрагентах(Ответ, Контекст) Экспорт
	Если Ответ = КодВозвратаДиалога.Отмена Или Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Контекст.СоздаватьКонтрагентов = (Ответ = КодВозвратаДиалога.Да);
	СопоставитьНоменклатуру(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура ПослеСопоставленияНоменклатуры(Результат, Контекст) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из Результат Цикл
		Контекст.Сопоставление.Добавить(Строка);
	КонецЦикла;
	СоздатьДокументыЗавершение(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыЗавершение(Контекст)
	Итог = СоздатьДокументыНаСервере(Контекст.Идентификаторы, Контекст.СоздаватьКонтрагентов, Контекст.Сопоставление);
	Для Каждого Ссылка Из Итог.Созданные Цикл
		ОповеститьОбИзменении(Ссылка);
	КонецЦикла;
	ОбновитьДоступность(ЭтотОбъект);
	ОбновитьПоляТекущегоДокумента();
	Текст = СтрШаблон(НСтр("ru = 'Создано документов: %1. Они не проведены — проверьте и проведите.'"), Итог.Созданные.Количество());
	Если Итог.Ошибок > 0 Тогда
		Текст = Текст + " " + СтрШаблон(НСтр("ru = 'Не созданы: %1 — причина в колонке «Требует проверки».'"), Итог.Ошибок);
	КонецЕсли;
	ПоказатьОповещениеПользователя(НСтр("ru = 'Typizer'"), , Текст);
КонецПроцедуры

&НаСервере
Функция СоздатьДокументыНаСервере(Идентификаторы, СоздаватьКонтрагентов, Сопоставление)
	Параметры_ = Новый Структура;
	Параметры_.Вставить("Организация", Организация);
	Параметры_.Вставить("Склад", Склад);
	Параметры_.Вставить("СоздаватьКонтрагентов", СоздаватьКонтрагентов);
	Параметры_.Вставить("Сопоставление", Сопоставление);
	Параметры_.Вставить("ПрикреплятьФайл", ПрикреплятьФайл);
	Параметры_.Вставить("СоздаватьСчетФактуру", СоздаватьСчетФактуру);
	Результаты = ТипизаторСозданиеДокументов.СоздатьДокументы(ЗаданияНаСоздание(Идентификаторы), Параметры_);

	Итог = Новый Структура("Созданные, Ошибок", Новый Массив, 0);
	Для Каждого Результат Из Результаты Цикл
		Строка = НайтиСтроку(Результат.Идентификатор);
		Строка.Предупреждения = СтрСоединить(Результат.Предупреждения, Символы.ПС);
		Если Результат.Успех Тогда
			Строка.СозданныйДокумент = Результат.Ссылка;
			Строка.Пометка = Ложь;
			УстановитьСтатус(Строка, ТипизаторКлиентСервер.СтатусСоздан());
			Итог.Созданные.Добавить(Результат.Ссылка);
		Иначе
			Строка.НаПроверку = Результат.ТекстОшибки;
			Итог.Ошибок = Итог.Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции

&НаСервере
Функция ЗаданияНаСоздание(Идентификаторы)
	Задания = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Строка = НайтиСтроку(Идентификатор);
		Документ = ПолучитьИзВременногоХранилища(Строка.АдресРезультата);
		Если ТипЗнч(Документ) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Задание = Новый Структура;
		Задание.Вставить("Идентификатор", Строка.Идентификатор);
		Задание.Вставить("Документ", Документ);
		Задание.Вставить("ВидДокумента", ВидДокумента);
		Задание.Вставить("ИмяФайла", Строка.ИмяФайла);
		Задание.Вставить("АдресФайла", Строка.АдресФайла);
		Задания.Добавить(Задание);
	КонецЦикла;
	Возврат Задания;
КонецФункции

#КонецОбласти

#Область ПоляДокумента

&НаКлиенте
Процедура ОбновитьПоляТекущегоДокумента()
	ТекущиеДанные = Элементы.Документы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоляДокумента.Очистить();
		Возврат;
	КонецЕсли;
	ЗаполнитьПоляДокумента(ТекущиеДанные.Идентификатор);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоляДокумента(Идентификатор)
	ПоляДокумента.Очистить();
	Строка = НайтиСтроку(Идентификатор);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ПустаяСтрока(Строка.ТекстОшибки) Тогда
		ДобавитьПоле(НСтр("ru = 'Ошибка'"), Строка.ТекстОшибки, Истина, "");
	КонецЕсли;
	Если Не ПустаяСтрока(Строка.Предупреждения) Тогда
		Для Каждого Предупреждение Из СтрРазделить(Строка.Предупреждения, Символы.ПС, Ложь) Цикл
			ДобавитьПоле(НСтр("ru = 'Обратите внимание'"), Предупреждение, Истина, "");
		КонецЦикла;
	КонецЕсли;
	Документ = ?(ПустаяСтрока(Строка.АдресРезультата), Неопределено, ПолучитьИзВременногоХранилища(Строка.АдресРезультата));
	Если ТипЗнч(Документ) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Причины = Новый Соответствие;
	Для Каждого Поле Из Документ.ПоляНаПроверку Цикл
		Причины.Вставить(Поле.Путь, Поле.Причина);
	КонецЦикла;

	ДобавитьПолеДокумента(НСтр("ru = 'Вид документа'"), Документ.ПредставлениеВида, Причины, "document_kind");
	ДобавитьПолеДокумента(НСтр("ru = 'Номер'"), Документ.Номер, Причины, "document_number");
	ДобавитьПолеДокумента(НСтр("ru = 'Дата'"), Формат(Документ.Дата, "ДЛФ=D"), Причины, "document_date");
	ДобавитьПолеДокумента(НСтр("ru = 'Продавец'"), Документ.Продавец.Наименование, Причины, "seller_name");
	ДобавитьПолеДокумента(НСтр("ru = 'ИНН / КПП продавца'"), ИННКПП(Документ.Продавец), Причины, "seller_inn,seller_kpp");
	ДобавитьПолеДокумента(НСтр("ru = 'Покупатель'"), Документ.Покупатель.Наименование, Причины, "buyer_name");
	ДобавитьПолеДокумента(НСтр("ru = 'ИНН / КПП покупателя'"), ИННКПП(Документ.Покупатель), Причины, "buyer_inn,buyer_kpp");
	Если Не ПустаяСтрока(Документ.НомерДоговора) Тогда
		ДобавитьПолеДокумента(НСтр("ru = 'Договор'"), СокрЛП(Документ.НомерДоговора + " " + Формат(Документ.ДатаДоговора, "ДЛФ=D; ДП=")), Причины, "contract_number,contract_date");
	КонецЕсли;
	Если Документ.ЕстьСчетФактура Тогда
		ДобавитьПолеДокумента(НСтр("ru = 'Счёт-фактура'"), СокрЛП(?(ПустаяСтрока(Документ.НомерСчетаФактуры), Документ.Номер, Документ.НомерСчетаФактуры)
			+ " " + Формат(?(ЗначениеЗаполнено(Документ.ДатаСчетаФактуры), Документ.ДатаСчетаФактуры, Документ.Дата), "ДЛФ=D; ДП=")),
			Причины, "invoice_factura_number,invoice_factura_date");
	КонецЕсли;
	НомерСтроки = 0;
	Для Каждого СтрокаДокумента Из Документ.Строки Цикл
		Путь = "items[" + Формат(НомерСтроки, "ЧН=0; ЧГ=0") + "]";
		НомерСтроки = НомерСтроки + 1;
		Значение = СтрШаблон("%1 — %2 × %3 = %4 (%5)", СтрокаДокумента.Наименование,
			Формат(СтрокаДокумента.Количество, "ЧГ=3,0"), Формат(СтрокаДокумента.Цена, "ЧДЦ=2; ЧГ=3,0"),
			Формат(СтрокаДокумента.Сумма, "ЧДЦ=2; ЧГ=3,0"), ТипизаторКлиентСервер.ПредставлениеСтавкиНДС(СтрокаДокумента.СтавкаНДС));
		ДобавитьПолеДокумента(СтрШаблон(НСтр("ru = 'Строка %1'"), НомерСтроки), Значение, Причины, Путь, Истина);
	КонецЦикла;
	ДобавитьПолеДокумента(НСтр("ru = 'Итого без НДС'"), Формат(Документ.ИтогоБезНДС, "ЧДЦ=2; ЧГ=3,0"), Причины, "total_without_vat");
	ДобавитьПолеДокумента(НСтр("ru = 'НДС'"), Формат(Документ.ИтогоНДС, "ЧДЦ=2; ЧГ=3,0"), Причины, "total_vat");
	ДобавитьПолеДокумента(НСтр("ru = 'Итого с НДС'"), Формат(Документ.Итого, "ЧДЦ=2; ЧГ=3,0"), Причины, "total");
КонецПроцедуры

&НаСервере
Процедура ДобавитьПолеДокумента(Представление, Значение, Причины, Пути, ПоПрефиксу = Ложь)
	ТекстыПричин = Новый Массив;
	Для Каждого Путь Из СтрРазделить(Пути, ",") Цикл
		Для Каждого Причина Из Причины Цикл
			Если Причина.Ключ = Путь Или (ПоПрефиксу И СтрНачинаетсяС(Причина.Ключ, Путь + ".")) Тогда
				ТекстыПричин.Добавить(?(ПоПрефиксу, ТипизаторКлиентСервер.ПредставлениеПоля(Причина.Ключ) + ": ", "") + Причина.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ДобавитьПоле(Представление, Значение, ТекстыПричин.Количество() > 0, СтрСоединить(ТекстыПричин, "; "));
КонецПроцедуры

&НаСервере
Процедура ДобавитьПоле(Представление, Значение, НаПроверку, Причина)
	Поле = ПоляДокумента.Добавить();
	Поле.Поле = Представление;
	Поле.Значение = Значение;
	Поле.НаПроверку = НаПроверку;
	Поле.Причина = Причина;
КонецПроцедуры

&НаСервере
Функция ИННКПП(Сторона)
	Возврат СокрЛП(Сторона.ИНН + ?(ПустаяСтрока(Сторона.КПП), "", " / " + Сторона.КПП));
КонецФункции

#КонецОбласти

#Область Прочее

&НаКлиенте
Процедура ПослеВопросаОНастройке(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ТипизаторКлиент.ОткрытьНастройки(ЭтотОбъект, Новый ОписаниеОповещения("ПослеЗакрытияНастроек", ЭтотОбъект));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияНастроек(Результат, ДополнительныеПараметры) Экспорт
	ПрочитатьНастройки();
	Если КлючЗадан Тогда
		НачатьРаспознавание();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройки()
	Настройки = ТипизаторСервер.Настройки();
	КлючЗадан = Настройки.КлючЗадан;
	ПрикреплятьФайл = Настройки.ПрикреплятьФайл;
	СоздаватьСчетФактуру = Настройки.СоздаватьСчетФактуру;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = Настройки.Организация;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Настройки.Склад;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НайтиСтроку(Идентификатор)
	Найденные = Документы.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
	Возврат ?(Найденные.Количество() = 0, Неопределено, Найденные[0]);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСтатус(Строка, Статус)
	Строка.Статус = Статус;
	Строка.СтатусПредставление = ТипизаторКлиентСервер.ПредставлениеСтатуса(Статус);
	Если Статус = ТипизаторКлиентСервер.СтатусОшибка() Тогда
		Строка.НаПроверку = Строка.ТекстОшибки;
	КонецЕсли;
	Строка.ОжиданиеПрервано = Статус = ТипизаторКлиентСервер.СтатусОшибка() И СтрНайти(Строка.ТекстОшибки, "дольше обычного") > 0;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДоступность(Форма)
	Элементы = Форма.Элементы;
	ЕстьСтроки = Форма.Документы.Количество() > 0;
	Элементы.ГруппаПрогресс.Видимость = Форма.ИдетРаспознавание Или ЕстьСтроки;
	Элементы.ДекорацияПодсказка.Видимость = Не ЕстьСтроки;
	Элементы.ГруппаШапка.ТолькоПросмотр = Форма.ИдетРаспознавание;
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	УсловноеОформление.Элементы.Очистить();
	ДобавитьОформлениеСтатуса(ТипизаторКлиентСервер.СтатусТребуетПроверки(), WebЦвета.ТемноОранжевый);
	ДобавитьОформлениеСтатуса(ТипизаторКлиентСервер.СтатусОшибка(), WebЦвета.Красный);
	ДобавитьОформлениеСтатуса(ТипизаторКлиентСервер.СтатусГотово(), WebЦвета.ЗеленыйЛес);
	ДобавитьОформлениеСтатуса(ТипизаторКлиентСервер.СтатусСоздан(), WebЦвета.ЗеленыйЛес);

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 243, 205));
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПоляДокумента.НаПроверку");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Для Каждого ИмяПоля Из СтрРазделить("ПоляДокументаПоле,ПоляДокументаЗначение,ПоляДокументаПричина", ",") Цикл
		Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеСтатуса(Статус, Цвет)
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Цвет);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Документы.Статус");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Статус;
	Для Каждого ИмяПоля Из СтрРазделить("ДокументыСтатусПредставление,ДокументыНаПроверку", ",") Цикл
		Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецОбласти
