///////////////////////////////////////////////////////////////////////////////////////////////////////
// Typizer: распознавание первичных документов.
// Создание документов 1С по распознанным данным: контрагенты, договоры, номенклатура, ставки НДС,
// «Поступление (акты, накладные, УПД)», «Счёт от поставщика», «Счёт-фактура полученный», присоединённый файл.
//
// Реквизиты объектов заполняются, только если они есть в конфигурации (см. УстановитьРеквизит), поэтому модуль
// не падает на релизах, где часть реквизитов называется иначе: что не удалось заполнить, попадает в предупреждения.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Что нужно решить пользователю до создания документов: новые контрагенты, несопоставленная номенклатура, дубли.
//
// Параметры:
//  Задания - Массив из Структура:
//   * Идентификатор - Строка
//   * Документ - Структура - распознанный документ, см. ТипизаторСервер.РазобратьРезультат.
//   * ВидДокумента - Строка - выбор пользователя.
//
// Возвращаемое значение:
//  Структура:
//   * НовыеКонтрагенты - Массив из Структура: ИНН, КПП, Наименование.
//   * Строки - Массив из Структура: ИННПоставщика, Поставщик, КлючСтроки, Наименование, Артикул, Единица, ЭтоУслуга,
//                                   Номенклатура, Найдено.
//   * Дубли - Соответствие из КлючИЗначение: ключ - идентификатор задания, значение - ДокументСсылка.
//
Функция ПодготовитьСоздание(Задания) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("НовыеКонтрагенты", Новый Массив);
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("Дубли", Новый Соответствие);

	УчтенныеКонтрагенты = Новый Соответствие;
	УчтенныеСтроки = Новый Соответствие;
	Для Каждого Задание Из Задания Цикл
		Документ = Задание.Документ;
		Продавец = Документ.Продавец;
		Контрагент = НайтиКонтрагента(Продавец.ИНН, Продавец.КПП);
		КлючКонтрагента = Продавец.ИНН + "/" + Продавец.КПП;
		Если Не ЗначениеЗаполнено(Контрагент) И УчтенныеКонтрагенты.Получить(КлючКонтрагента) = Неопределено Тогда
			УчтенныеКонтрагенты.Вставить(КлючКонтрагента, Истина);
			Результат.НовыеКонтрагенты.Добавить(Новый Структура("ИНН, КПП, Наименование",
				Продавец.ИНН, Продавец.КПП, Продавец.Наименование));
		КонецЕсли;

		Если ЗначениеЗаполнено(Контрагент) Тогда
			ИмяДокумента = ТипизаторКлиентСервер.СоздаваемыйДокумент(Задание.ВидДокумента, Документ.КодВида);
			Дубль = НайтиДубль(ИмяДокумента, Контрагент, Документ.Номер, Документ.Дата);
			Если ЗначениеЗаполнено(Дубль) Тогда
				Результат.Дубли.Вставить(Задание.Идентификатор, Дубль);
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Для Каждого Строка Из Документ.Строки Цикл
			КлючСтроки = ТипизаторКлиентСервер.КлючСтрокиНоменклатуры(Строка.Артикул, Строка.Наименование);
			Если УчтенныеСтроки.Получить(Продавец.ИНН + "|" + КлючСтроки) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			УчтенныеСтроки.Вставить(Продавец.ИНН + "|" + КлючСтроки, Истина);
			Номенклатура = НайтиНоменклатуру(Продавец.ИНН, КлючСтроки, Строка.Артикул, Строка.Наименование);
			Описание = Новый Структура;
			Описание.Вставить("ИННПоставщика", Продавец.ИНН);
			Описание.Вставить("Поставщик", Продавец.Наименование);
			Описание.Вставить("КлючСтроки", КлючСтроки);
			Описание.Вставить("Наименование", Строка.Наименование);
			Описание.Вставить("Артикул", Строка.Артикул);
			Описание.Вставить("Единица", Строка.Единица);
			Описание.Вставить("КодЕдиницы", Строка.КодЕдиницы);
			Описание.Вставить("ЭтоУслуга", Строка.ЭтоУслуга);
			Описание.Вставить("СтавкаНДС", Строка.СтавкаНДС);
			Описание.Вставить("Номенклатура", Номенклатура);
			Описание.Вставить("Найдено", ЗначениеЗаполнено(Номенклатура));
			Результат.Строки.Добавить(Описание);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Создаёт непроведённые документы по распознанным данным.
//
// Параметры:
//  Задания - Массив из Структура:
//   * Идентификатор - Строка
//   * Документ - Структура - см. ТипизаторСервер.РазобратьРезультат.
//   * ВидДокумента - Строка
//   * ИмяФайла - Строка
//   * АдресФайла - Строка - адрес исходного файла во временном хранилище.
//  Параметры - Структура:
//   * Организация - СправочникСсылка.Организации - организация по умолчанию.
//   * Склад - СправочникСсылка.Склады
//   * СоздаватьКонтрагентов - Булево
//   * Сопоставление - Массив из Структура: ИННПоставщика, КлючСтроки, Номенклатура, Запомнить, Создать,
//                                           Наименование, Артикул, Единица, КодЕдиницы, ЭтоУслуга, СтавкаНДС.
//   * ПрикреплятьФайл - Булево
//   * СоздаватьСчетФактуру - Булево
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Идентификатор - Строка
//   * Успех - Булево
//   * Ссылка - ДокументСсылка, Неопределено
//   * ТекстОшибки - Строка
//   * Предупреждения - Массив из Строка
//
Функция СоздатьДокументы(Задания, Параметры) Экспорт
	Номенклатура = ПрименитьСопоставление(Параметры.Сопоставление);
	Результаты = Новый Массив;
	Для Каждого Задание Из Задания Цикл
		Результат = Новый Структура("Идентификатор, Успех, Ссылка, ТекстОшибки, Предупреждения",
			Задание.Идентификатор, Ложь, Неопределено, "", Новый Массив);
		Попытка
			СоздатьДокумент(Задание, Параметры, Номенклатура, Результат);
		Исключение
			Результат.Успех = Ложь;
			Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Typizer.Создание документов'"), УровеньЖурналаРегистрации.Ошибка, , ,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Результаты.Добавить(Результат);
	КонецЦикла;
	Возврат Результаты;
КонецФункции

// Ищет контрагента по ИНН и КПП. Если с таким ИНН несколько — выбирает с совпадающим КПП.
//
// Параметры:
//  ИНН - Строка
//  КПП - Строка
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты, Неопределено
//
Функция НайтиКонтрагента(ИНН, КПП) Экспорт
	Если ПустаяСтрока(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Контрагенты.КПП = &КПП
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ПометкаУдаления" + УсловиеНеГруппа("Контрагенты") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

// Ищет организацию по ИНН.
//
// Параметры:
//  ИНН - Строка
//
// Возвращаемое значение:
//  СправочникСсылка.Организации, Неопределено
//
Функция НайтиОрганизацию(ИНН) Экспорт
	Если ПустаяСтрока(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН = &ИНН
	|	И НЕ Организации.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

// Ищет номенклатуру строки: сначала запомненное сопоставление, затем артикул, затем наименование.
//
// Параметры:
//  ИННПоставщика - Строка
//  КлючСтроки - Строка - см. ТипизаторКлиентСервер.КлючСтрокиНоменклатуры.
//  Артикул - Строка
//  Наименование - Строка
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура, Неопределено
//
Функция НайтиНоменклатуру(ИННПоставщика, КлючСтроки, Артикул, Наименование) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сопоставление.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ТипизаторСопоставлениеНоменклатуры КАК Сопоставление
	|ГДЕ
	|	Сопоставление.ИННПоставщика = &ИННПоставщика
	|	И Сопоставление.КлючСтроки = &КлючСтроки
	|	И НЕ Сопоставление.Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИННПоставщика", ИННПоставщика);
	Запрос.УстановитьПараметр("КлючСтроки", КлючСтроки);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Номенклатура;
	КонецЕсли;

	Если Не ПустаяСтрока(Артикул) Тогда
		Найденная = НоменклатураПоРеквизиту("Артикул", СокрЛП(Артикул));
		Если Найденная <> Неопределено Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(Наименование) Тогда
		Найденная = НоменклатураПоРеквизиту("Наименование", Лев(СокрЛП(Наименование), 150));
		Если Найденная = Неопределено И ЕстьРеквизит(Метаданные.Справочники.Номенклатура, "НаименованиеПолное") Тогда
			Найденная = НоменклатураПоРеквизиту("НаименованиеПолное", СокрЛП(Наименование));
		КонецЕсли;
		Возврат Найденная;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Запоминает, какой номенклатуре соответствует строка документа поставщика.
//
// Параметры:
//  ИННПоставщика - Строка
//  КлючСтроки - Строка
//  Номенклатура - СправочникСсылка.Номенклатура
//  Наименование - Строка - наименование в документе поставщика.
//  Артикул - Строка
//
Процедура ЗапомнитьСопоставление(ИННПоставщика, КлючСтроки, Номенклатура, Наименование, Артикул) Экспорт
	Если ПустаяСтрока(ИННПоставщика) Или Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	Запись = РегистрыСведений.ТипизаторСопоставлениеНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.ИННПоставщика = ИННПоставщика;
	Запись.КлючСтроки = КлючСтроки;
	Запись.Номенклатура = Номенклатура;
	Запись.НаименованиеВДокументе = Наименование;
	Запись.Артикул = Артикул;
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.Записать(Истина);
КонецПроцедуры

// Значение ставки НДС конфигурации по коду ставки.
//
// Параметры:
//  Код - Строка - см. ТипизаторКлиентСервер.КодСтавкиНДС.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СтавкиНДС, СправочникСсылка, Неопределено
//
Функция СтавкаНДС(Код) Экспорт
	Если ПустаяСтрока(Код) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИменаЗначений = Новый Соответствие;
	ИменаЗначений.Вставить("22", "НДС22");
	ИменаЗначений.Вставить("20", "НДС20");
	ИменаЗначений.Вставить("10", "НДС10");
	ИменаЗначений.Вставить("7", "НДС7");
	ИменаЗначений.Вставить("5", "НДС5");
	ИменаЗначений.Вставить("0", "НДС0");
	ИменаЗначений.Вставить("БезНДС", "БезНДС");
	ИменаЗначений.Вставить("22/122", "НДС22_122");
	ИменаЗначений.Вставить("20/120", "НДС20_120");
	ИменаЗначений.Вставить("10/110", "НДС10_110");
	Значение = ЗначениеПеречисления("СтавкиНДС", ИменаЗначений.Получить(Код));
	Если Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	// В конфигурациях, где ставки НДС — справочник, ищем по наименованию («22%», «Без НДС»).
	Если Метаданные.Справочники.Найти("СтавкиНДС") <> Неопределено Тогда
		Найденная = Справочники["СтавкиНДС"].НайтиПоНаименованию(ТипизаторКлиентСервер.ПредставлениеСтавкиНДС(Код), Истина);
		Если ЗначениеЗаполнено(Найденная) Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СозданиеДокумента

Процедура СоздатьДокумент(Задание, Параметры, Номенклатура, Результат)
	Документ = Задание.Документ;
	Продавец = Документ.Продавец;
	Предупреждения = Результат.Предупреждения;

	Организация = ОрганизацияДокумента(Документ, Параметры.Организация, Предупреждения);
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось определить организацию: ИНН покупателя не найден среди организаций. Выберите организацию вверху формы.'");
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Контрагент = НайтиКонтрагента(Продавец.ИНН, Продавец.КПП);
		Если Не ЗначениеЗаполнено(Контрагент) Тогда
			Если Не Параметры.СоздаватьКонтрагентов Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Контрагент с ИНН %1 не найден. Создайте его или разрешите создание при загрузке.'"), Продавец.ИНН);
			КонецЕсли;
			Если ПустаяСтрока(Продавец.ИНН) Тогда
				ВызватьИсключение НСтр("ru = 'В документе не найден ИНН продавца — контрагента не по чему найти. Создайте документ вручную.'");
			КонецЕсли;
			Контрагент = СоздатьКонтрагента(Продавец);
			Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Создан контрагент «%1» — проверьте его реквизиты.'"), Продавец.Наименование));
		КонецЕсли;
		Договор = ДоговорПоставщика(Контрагент, Организация, Документ.НомерДоговора, Документ.ДатаДоговора, Предупреждения);

		ИмяДокумента = ТипизаторКлиентСервер.СоздаваемыйДокумент(Задание.ВидДокумента, Документ.КодВида);
		Объект = Документы[ИмяДокумента].СоздатьДокумент();
		ДанныеЗаполнения = Новый Структура("Организация, Контрагент, ДоговорКонтрагента", Организация, Контрагент, Договор);
		Если ИмяДокумента = "ПоступлениеТоваровУслуг" Тогда
			ВидОперации = ВидОперацииПоступления(Документ);
			Если ВидОперации <> Неопределено Тогда
				ДанныеЗаполнения.Вставить("ВидОперации", ВидОперации);
			КонецЕсли;
		КонецЕсли;
		// Типовое заполнение конфигурации: ответственный, валюта, счета расчётов и т. п.
		Объект.Заполнить(ДанныеЗаполнения);

		Объект.Дата = ?(ЗначениеЗаполнено(Документ.Дата), Документ.Дата, ТекущаяДатаСеанса());
		УстановитьРеквизит(Объект, "Организация", Организация);
		УстановитьРеквизит(Объект, "Контрагент", Контрагент);
		УстановитьРеквизит(Объект, "ДоговорКонтрагента", Договор);
		Если ДанныеЗаполнения.Свойство("ВидОперации") Тогда
			УстановитьРеквизит(Объект, "ВидОперации", ДанныеЗаполнения.ВидОперации);
		КонецЕсли;
		Если ЗначениеЗаполнено(Параметры.Склад) Тогда
			УстановитьРеквизит(Объект, "Склад", Параметры.Склад);
		КонецЕсли;
		УстановитьРеквизит(Объект, "НомерВходящегоДокумента", Документ.Номер);
		УстановитьРеквизит(Объект, "ДатаВходящегоДокумента", Документ.Дата);
		УстановитьРеквизит(Объект, "СуммаВключаетНДС", Документ.ЦеныВключаютНДС);
		УстановитьРеквизит(Объект, "ЭтоУниверсальныйДокумент", Документ.КодВида = "upd");
		ЗаполнитьВалюту(Объект);

		ЗаполнитьСтроки(Объект, ИмяДокумента, Документ, Продавец.ИНН, Номенклатура, Предупреждения);
		УстановитьРеквизит(Объект, "СуммаДокумента", Документ.Итого);
		УстановитьРеквизит(Объект, "Комментарий", Комментарий(Задание.ИмяФайла, Документ));

		Объект.Записать(РежимЗаписиДокумента.Запись);

		Если ИмяДокумента = "ПоступлениеТоваровУслуг" И Документ.ЕстьСчетФактура И Параметры.СоздаватьСчетФактуру Тогда
			СоздатьСчетФактуру(Объект, Документ, Предупреждения);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Результат.Успех = Истина;
	Результат.Ссылка = Объект.Ссылка;
	Если Параметры.ПрикреплятьФайл И ЗначениеЗаполнено(Задание.АдресФайла) Тогда
		ПрикрепитьФайл(Объект.Ссылка, Задание.АдресФайла, Задание.ИмяФайла, Предупреждения);
	КонецЕсли;
КонецПроцедуры

Функция ОрганизацияДокумента(Документ, ОрганизацияПоУмолчанию, Предупреждения)
	ПоИНН = НайтиОрганизацию(Документ.Покупатель.ИНН);
	Если ЗначениеЗаполнено(ОрганизацияПоУмолчанию) Тогда
		Если ЗначениеЗаполнено(ПоИНН) И ПоИНН <> ОрганизацияПоУмолчанию Тогда
			Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'ИНН покупателя в документе (%1) относится к организации «%2», а документ создан на «%3».'"),
				Документ.Покупатель.ИНН, ПоИНН, ОрганизацияПоУмолчанию));
		КонецЕсли;
		Возврат ОрганизацияПоУмолчанию;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПоИНН) Тогда
		Возврат ПоИНН;
	КонецЕсли;
	// Если организация в базе одна — берём её.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления");
	Выгрузка = Запрос.Выполнить().Выгрузить();
	Возврат ?(Выгрузка.Количество() = 1, Выгрузка[0].Ссылка, Неопределено);
КонецФункции

Процедура ЗаполнитьСтроки(Объект, ИмяДокумента, Документ, ИННПоставщика, Номенклатура, Предупреждения)
	ЕстьУслуги = Объект.Метаданные().ТабличныеЧасти.Найти("Услуги") <> Неопределено;
	Для Каждого Строка Из Документ.Строки Цикл
		КлючСтроки = ТипизаторКлиентСервер.КлючСтрокиНоменклатуры(Строка.Артикул, Строка.Наименование);
		СсылкаНоменклатуры = Номенклатура.Получить(ИННПоставщика + "|" + КлючСтроки);
		Если Строка.ЭтоУслуга И ЕстьУслуги Тогда
			ИмяТабличнойЧасти = "Услуги";
		Иначе
			ИмяТабличнойЧасти = "Товары";
		КонецЕсли;
		НоваяСтрока = Объект[ИмяТабличнойЧасти].Добавить();
		УстановитьРеквизит(НоваяСтрока, "Номенклатура", СсылкаНоменклатуры, Объект, ИмяТабличнойЧасти);
		УстановитьРеквизит(НоваяСтрока, "Содержание", Строка.Наименование, Объект, ИмяТабличнойЧасти);
		Количество = ?(Строка.Количество = 0, 1, Строка.Количество);
		Сумма = ?(Документ.ЦеныВключаютНДС, Строка.Сумма, Строка.СуммаБезНДС);
		Цена = Строка.Цена;
		Если Макс(Цена * Количество - Сумма, Сумма - Цена * Количество) > 0.01 * Количество + 0.01 Тогда
			Цена = Окр(Сумма / Количество, 2);
		КонецЕсли;
		УстановитьРеквизит(НоваяСтрока, "Количество", Количество, Объект, ИмяТабличнойЧасти);
		УстановитьРеквизит(НоваяСтрока, "Цена", Цена, Объект, ИмяТабличнойЧасти);
		УстановитьРеквизит(НоваяСтрока, "Сумма", Сумма, Объект, ИмяТабличнойЧасти);
		Ставка = СтавкаНДС(Строка.СтавкаНДС);
		Если Ставка = Неопределено Тогда
			Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Строка «%1»: ставка НДС не распознана — укажите её вручную.'"), Строка.Наименование));
		Иначе
			УстановитьРеквизит(НоваяСтрока, "СтавкаНДС", Ставка, Объект, ИмяТабличнойЧасти);
		КонецЕсли;
		УстановитьРеквизит(НоваяСтрока, "СуммаНДС", Строка.СуммаНДС, Объект, ИмяТабличнойЧасти);
		Если Не ЗначениеЗаполнено(СсылкаНоменклатуры) Тогда
			Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Строка «%1»: номенклатура не выбрана.'"), Строка.Наименование));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ВидОперацииПоступления(Документ)
	ЕстьТовары = Ложь;
	ЕстьУслуги = Ложь;
	Для Каждого Строка Из Документ.Строки Цикл
		Если Строка.ЭтоУслуга Тогда
			ЕстьУслуги = Истина;
		Иначе
			ЕстьТовары = Истина;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьУслуги И Не ЕстьТовары Тогда
		ИмяЗначения = "Услуги";
	ИначеЕсли ЕстьУслуги И ЕстьТовары Тогда
		ИмяЗначения = "ПокупкаКомиссия";
	Иначе
		ИмяЗначения = "Товары";
	КонецЕсли;
	Значение = ЗначениеПеречисления("ВидыОперацийПоступлениеТоваровУслуг", ИмяЗначения);
	Если Значение = Неопределено Тогда
		Значение = ЗначениеПеречисления("ВидыОперацийПоступлениеТоваровУслуг", "Товары");
	КонецЕсли;
	Возврат Значение;
КонецФункции

Процедура СоздатьСчетФактуру(Основание, Документ, Предупреждения)
	Если Метаданные.Документы.Найти("СчетФактураПолученный") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СчетФактура = Документы["СчетФактураПолученный"].СоздатьДокумент();
	// Типовое заполнение по документу поступления: суммы, вид счёта-фактуры, код вида операции.
	СчетФактура.Заполнить(Основание.Ссылка);
	СчетФактура.Дата = Основание.Дата;
	УстановитьРеквизит(СчетФактура, "Организация", Основание.Организация);
	УстановитьРеквизит(СчетФактура, "Контрагент", Основание.Контрагент);
	УстановитьРеквизит(СчетФактура, "ДоговорКонтрагента", Основание.ДоговорКонтрагента);
	УстановитьРеквизит(СчетФактура, "ДокументОснование", Основание.Ссылка);
	НомерСчетаФактуры = ?(ПустаяСтрока(Документ.НомерСчетаФактуры), Документ.Номер, Документ.НомерСчетаФактуры);
	ДатаСчетаФактуры = ?(ЗначениеЗаполнено(Документ.ДатаСчетаФактуры), Документ.ДатаСчетаФактуры, Документ.Дата);
	УстановитьРеквизит(СчетФактура, "НомерВходящегоДокумента", НомерСчетаФактуры);
	УстановитьРеквизит(СчетФактура, "ДатаВходящегоДокумента", ДатаСчетаФактуры);
	Если Не ЗначениеЗаполнено(СчетФактура["СуммаДокумента"]) Тогда
		УстановитьРеквизит(СчетФактура, "СуммаДокумента", Документ.Итого);
	КонецЕсли;
	СчетФактура.Записать(РежимЗаписиДокумента.Запись);
	Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Зарегистрирован счёт-фактура № %1 — проведите его после проверки поступления.'"), НомерСчетаФактуры));
КонецПроцедуры

Процедура ПрикрепитьФайл(Владелец, АдресФайла, ИмяФайла, Предупреждения)
	Попытка
		Расширение = ТипизаторAPIКлиентСервер.РасширениеФайла(ИмяФайла);
		ИмяБезРасширения = ?(ПустаяСтрока(Расширение), ИмяФайла, Лев(ИмяФайла, СтрДлина(ИмяФайла) - СтрДлина(Расширение) - 1));
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
		Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
		ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
		ПараметрыФайла.ВладелецФайлов = Владелец;
		ПараметрыФайла.ИмяБезРасширения = ИмяБезРасширения;
		ПараметрыФайла.РасширениеБезТочки = Расширение;
		ПараметрыФайла.ВремяИзменения = ТекущаяДатаСеанса();
		ПараметрыФайла.ВремяИзмененияУниверсальное = ТекущаяУниверсальнаяДата();
		РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Адрес, , НСтр("ru = 'Исходный документ, распознан Typizer'"));
	Исключение
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Не удалось прикрепить исходный файл: %1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
КонецПроцедуры

Функция Комментарий(ИмяФайла, Документ)
	Текст = СтрШаблон(НСтр("ru = 'Создан Typizer из файла «%1».'"), ИмяФайла);
	Если Документ.ПоляНаПроверку.Количество() > 0 Тогда
		Поля = Новый Массив;
		Для Каждого Поле Из Документ.ПоляНаПроверку Цикл
			Поля.Добавить(Поле.Поле);
		КонецЦикла;
		Текст = Текст + " " + СтрШаблон(НСтр("ru = 'Проверьте: %1.'"), СтрСоединить(Поля, ", "));
	КонецЕсли;
	Возврат Лев(Текст, 1000);
КонецФункции

Функция НайтиДубль(ИмяДокумента, Контрагент, Номер, Дата)
	Если ПустаяСтрока(Номер) Тогда
		Возврат Неопределено;
	КонецЕсли;
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Или Не ЕстьРеквизит(МетаданныеДокумента, "НомерВходящегоДокумента") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Документ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.#Имя КАК Документ
	|ГДЕ
	|	Документ.Контрагент = &Контрагент
	|	И Документ.НомерВходящегоДокумента = &Номер
	|	И Документ.ДатаВходящегоДокумента = &Дата
	|	И НЕ Документ.ПометкаУдаления", "#Имя", ИмяДокумента);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Дата", Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

#КонецОбласти

#Область Справочники

Функция СоздатьКонтрагента(Продавец)
	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);
	Наименование = ?(ПустаяСтрока(Продавец.Наименование), СтрШаблон(НСтр("ru = 'Контрагент ИНН %1'"), Продавец.ИНН), Продавец.Наименование);
	Объект.Наименование = Лев(Наименование, Метаданные.Справочники.Контрагенты.ДлинаНаименования);
	УстановитьРеквизит(Объект, "НаименованиеПолное", Наименование);
	УстановитьРеквизит(Объект, "ИНН", Продавец.ИНН);
	ЭтоФизЛицо = СтрДлина(Продавец.ИНН) = 12;
	Если Не ЭтоФизЛицо Тогда
		УстановитьРеквизит(Объект, "КПП", Продавец.КПП);
	КонецЕсли;
	ВидЛица = ЗначениеПеречисления("ЮридическоеФизическоеЛицо", ?(ЭтоФизЛицо, "ФизическоеЛицо", "ЮридическоеЛицо"));
	Если ВидЛица <> Неопределено Тогда
		УстановитьРеквизит(Объект, "ЮридическоеФизическоеЛицо", ВидЛица);
	КонецЕсли;
	Если Метаданные.Справочники.Найти("СтраныМира") <> Неопределено Тогда
		Россия = Справочники["СтраныМира"].НайтиПоКоду("643");
		Если ЗначениеЗаполнено(Россия) Тогда
			УстановитьРеквизит(Объект, "СтранаРегистрации", Россия);
		КонецЕсли;
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция ДоговорПоставщика(Контрагент, Организация, НомерДоговора, ДатаДоговора, Предупреждения)
	МетаданныеДоговоров = Метаданные.Справочники.ДоговорыКонтрагентов;
	ВидДоговора = ЗначениеПеречисления("ВидыДоговоровКонтрагентов", "СПоставщиком");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА &НомерДоговора <> """" И Договоры.Номер = &НомерДоговора
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Порядок,
	|	Договоры.Дата КАК Дата
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.Владелец = &Контрагент
	|	И Договоры.Организация = &Организация
	|	И НЕ Договоры.ПометкаУдаления" + ?(ВидДоговора = Неопределено, "", "
	|	И Договоры.ВидДоговора = &ВидДоговора") + УсловиеНеГруппа("ДоговорыКонтрагентов", "Договоры") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Дата УБЫВ";
	Если Не ЕстьРеквизит(МетаданныеДоговоров, "Номер") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Договоры.Номер = &НомерДоговора", "И ЛОЖЬ");
	КонецЕсли;
	Если Не ЕстьРеквизит(МетаданныеДоговоров, "Дата") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Договоры.Дата КАК Дата", "1 КАК Дата");
	КонецЕсли;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Запрос.УстановитьПараметр("НомерДоговора", НомерДоговора);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Объект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Объект.Владелец = Контрагент;
	Объект.Заполнить(Неопределено);
	Если ПустаяСтрока(НомерДоговора) Тогда
		Объект.Наименование = НСтр("ru = 'Основной договор'");
	ИначеЕсли ЗначениеЗаполнено(ДатаДоговора) Тогда
		Объект.Наименование = СтрШаблон(НСтр("ru = 'Договор № %1 от %2'"), НомерДоговора, Формат(ДатаДоговора, "ДЛФ=D"));
	Иначе
		Объект.Наименование = СтрШаблон(НСтр("ru = 'Договор № %1'"), НомерДоговора);
	КонецЕсли;
	УстановитьРеквизит(Объект, "Организация", Организация);
	Если ВидДоговора <> Неопределено Тогда
		УстановитьРеквизит(Объект, "ВидДоговора", ВидДоговора);
	КонецЕсли;
	УстановитьРеквизит(Объект, "Номер", НомерДоговора);
	УстановитьРеквизит(Объект, "Дата", ДатаДоговора);
	Если ЕстьРеквизит(МетаданныеДоговоров, "ВалютаВзаиморасчетов") И Не ЗначениеЗаполнено(Объект["ВалютаВзаиморасчетов"]) Тогда
		УстановитьРеквизит(Объект, "ВалютаВзаиморасчетов", ВалютаРегламентированногоУчета());
	КонецЕсли;
	Объект.Записать();
	Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Создан договор «%1» с поставщиком.'"), Объект.Наименование));
	Возврат Объект.Ссылка;
КонецФункции

// Возвращает соответствие «ИНН|ключ строки» → номенклатура, создаёт новую номенклатуру и запоминает сопоставления.
Функция ПрименитьСопоставление(Сопоставление)
	Результат = Новый Соответствие;
	Если Сопоставление = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Строка Из Сопоставление Цикл
		Номенклатура = Строка.Номенклатура;
		Если Не ЗначениеЗаполнено(Номенклатура) И Строка.Создать Тогда
			Номенклатура = СоздатьНоменклатуру(Строка);
		КонецЕсли;
		Если ЗначениеЗаполнено(Номенклатура) И Строка.Запомнить Тогда
			ЗапомнитьСопоставление(Строка.ИННПоставщика, Строка.КлючСтроки, Номенклатура, Строка.Наименование, Строка.Артикул);
		КонецЕсли;
		Результат.Вставить(Строка.ИННПоставщика + "|" + Строка.КлючСтроки, Номенклатура);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СоздатьНоменклатуру(Строка)
	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);
	Объект.Наименование = Лев(Строка.Наименование, Метаданные.Справочники.Номенклатура.ДлинаНаименования);
	УстановитьРеквизит(Объект, "НаименованиеПолное", Строка.Наименование);
	УстановитьРеквизит(Объект, "Артикул", Строка.Артикул);
	УстановитьРеквизит(Объект, "Услуга", Строка.ЭтоУслуга);
	Единица = ЕдиницаИзмерения(Строка.КодЕдиницы, Строка.Единица);
	Если ЗначениеЗаполнено(Единица) Тогда
		УстановитьРеквизит(Объект, "ЕдиницаИзмерения", Единица);
	КонецЕсли;
	Ставка = СтавкаНДС(Строка.СтавкаНДС);
	Если Ставка <> Неопределено Тогда
		УстановитьРеквизит(Объект, "СтавкаНДС", Ставка);
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция ЕдиницаИзмерения(Код, Наименование)
	Если Метаданные.Справочники.Найти("КлассификаторЕдиницИзмерения") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Менеджер = Справочники["КлассификаторЕдиницИзмерения"];
	Если Не ПустаяСтрока(Код) Тогда
		Найденная = Менеджер.НайтиПоКоду(Код);
		Если ЗначениеЗаполнено(Найденная) Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(Наименование) Тогда
		Найденная = Менеджер.НайтиПоНаименованию(СокрЛП(Наименование), Истина);
		Если ЗначениеЗаполнено(Найденная) Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НоменклатураПоРеквизиту(ИмяРеквизита, Значение)
	Если ИмяРеквизита <> "Наименование" И Не ЕстьРеквизит(Метаданные.Справочники.Номенклатура, ИмяРеквизита) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.#Реквизит = &Значение
	|	И НЕ Номенклатура.ПометкаУдаления", "#Реквизит", ИмяРеквизита) + УсловиеНеГруппа("Номенклатура");
	Если ИмяРеквизита = "НаименованиеПолное" Тогда
		// Неограниченная строка сравнивается через ПОДСТРОКА.
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура.НаименованиеПолное = &Значение",
			"ПОДСТРОКА(Номенклатура.НаименованиеПолное, 1, 1000) = &Значение");
	КонецЕсли;
	Запрос.УстановитьПараметр("Значение", Значение);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

Функция ВалютаРегламентированногоУчета()
	Если Метаданные.Константы.Найти("ВалютаРегламентированногоУчета") <> Неопределено Тогда
		Валюта = Константы["ВалютаРегламентированногоУчета"].Получить();
		Если ЗначениеЗаполнено(Валюта) Тогда
			Возврат Валюта;
		КонецЕсли;
	КонецЕсли;
	Если Метаданные.Справочники.Найти("Валюты") <> Неопределено Тогда
		Возврат Справочники["Валюты"].НайтиПоКоду("643");
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ЗаполнитьВалюту(Объект)
	Если Не ЕстьРеквизит(Объект.Метаданные(), "ВалютаДокумента") Или ЗначениеЗаполнено(Объект["ВалютаДокумента"]) Тогда
		Возврат;
	КонецЕсли;
	Валюта = ВалютаРегламентированногоУчета();
	Если ЗначениеЗаполнено(Валюта) Тогда
		Объект["ВалютаДокумента"] = Валюта;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Метаданные_

// Устанавливает реквизит объекта или строки табличной части, если такой реквизит есть в конфигурации.
Процедура УстановитьРеквизит(Приемник, Имя, Значение, Объект = Неопределено, ИмяТабличнойЧасти = "")
	Если ПустаяСтрока(ИмяТабличнойЧасти) Тогда
		МетаданныеПриемника = Приемник.Метаданные();
	Иначе
		МетаданныеПриемника = Объект.Метаданные().ТабличныеЧасти[ИмяТабличнойЧасти];
	КонецЕсли;
	Если Не ЕстьРеквизит(МетаданныеПриемника, Имя) Тогда
		Возврат;
	КонецЕсли;
	Приемник[Имя] = Значение;
КонецПроцедуры

Функция ЕстьРеквизит(МетаданныеОбъекта, Имя)
	Если МетаданныеОбъекта.Реквизиты.Найти(Имя) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Возврат МетаданныеОбъекта.СтандартныеРеквизиты.Найти(Имя) <> Неопределено;
	Исключение
		// У табличных частей стандартных реквизитов «Наименование» и т. п. нет.
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ЗначениеПеречисления(ИмяПеречисления, ИмяЗначения)
	Если ИмяЗначения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	МетаданныеПеречисления = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если МетаданныеПеречисления = Неопределено Или МетаданныеПеречисления.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];
КонецФункции

Функция УсловиеНеГруппа(ИмяСправочника, Псевдоним = "")
	МетаданныеСправочника = Метаданные.Справочники[ИмяСправочника];
	Если Не МетаданныеСправочника.Иерархический
		Или МетаданныеСправочника.ВидИерархии <> Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Возврат "";
	КонецЕсли;
	Возврат Символы.ПС + "	И НЕ " + ?(ПустаяСтрока(Псевдоним), ИмяСправочника, Псевдоним) + ".ЭтоГруппа";
КонецФункции

#КонецОбласти

#КонецОбласти
