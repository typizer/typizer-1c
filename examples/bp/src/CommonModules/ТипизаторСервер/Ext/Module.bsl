///////////////////////////////////////////////////////////////////////////////////////////////////////
// Typizer: распознавание первичных документов.
// Сервер: настройки подключения, фоновое распознавание, разбор результата.
// Обращение к сервису — через Typizer SDK (общие модули ТипизаторAPI, ТипизаторAPIКлиентСервер).
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область Настройки

// Настройки текущего пользователя и общие настройки подключения.
//
// Возвращаемое значение:
//  Структура:
//   * АдресСервиса - Строка
//   * КлючЗадан - Булево - ключ API сохранён (сам ключ на клиент не передаётся).
//   * Организация - СправочникСсылка.Организации
//   * Склад - СправочникСсылка.Склады
//   * ВидДокумента - Строка - вид документа по умолчанию.
//   * ТочныйРежим - Булево - распознавать в режиме повышенной точности.
//   * ПрикреплятьФайл - Булево - прикреплять исходный файл к созданному документу.
//   * СоздаватьСчетФактуру - Булево - регистрировать счёт-фактуру полученный.
//
Функция Настройки() Экспорт
	Результат = НастройкиПоУмолчанию();
	УстановитьПривилегированныйРежим(Истина);
	Результат.АдресСервиса = Константы.ТипизаторАдресСервиса.Получить();
	Результат.ТочныйРежим = Константы.ТипизаторТочныйРежим.Получить();
	УстановитьПривилегированныйРежим(Ложь);
	Личные = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючНастроек(), "Пользователь");
	Если ТипЗнч(Личные) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Результат, Личные, "Организация, Склад, ВидДокумента, ПрикреплятьФайл, СоздаватьСчетФактуру");
	КонецЕсли;
	Если ПустаяСтрока(Результат.АдресСервиса) Тогда
		Результат.АдресСервиса = ТипизаторAPIКлиентСервер.АдресСервисаПоУмолчанию();
	КонецЕсли;
	Результат.КлючЗадан = Не ПустаяСтрока(КлючAPI());
	Возврат Результат;
КонецФункции

// Сохраняет настройки. Общие настройки и ключ API может менять только администратор.
//
// Параметры:
//  НовыеНастройки - Структура - см. Настройки().
//  НовыйКлючAPI - Строка, Неопределено - Неопределено, если ключ не меняется.
//
Процедура ЗаписатьНастройки(НовыеНастройки, НовыйКлючAPI = Неопределено) Экспорт
	Личные = Новый Структура("Организация, Склад, ВидДокумента, ПрикреплятьФайл, СоздаватьСчетФактуру");
	ЗаполнитьЗначенияСвойств(Личные, НовыеНастройки);
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючНастроек(), "Пользователь", Личные);

	ИзменяютсяОбщие = НовыйКлючAPI <> Неопределено;
	Текущие = Настройки();
	Если НовыеНастройки.АдресСервиса <> Текущие.АдресСервиса Или НовыеНастройки.ТочныйРежим <> Текущие.ТочныйРежим Тогда
		ИзменяютсяОбщие = Истина;
	КонецЕсли;
	Если Не ИзменяютсяОбщие Тогда
		Возврат;
	КонецЕсли;
	ПроверитьПравоАдминистрирования();

	УстановитьПривилегированныйРежим(Истина);
	Константы.ТипизаторАдресСервиса.Установить(ТипизаторAPIКлиентСервер.НормализованныйАдресСервиса(НовыеНастройки.АдресСервиса));
	Константы.ТипизаторТочныйРежим.Установить(НовыеНастройки.ТочныйРежим);
	Если НовыйКлючAPI <> Неопределено Тогда
		Если ПустаяСтрока(НовыйКлючAPI) Тогда
			ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ВладелецКлюча(), "КлючAPI");
		Иначе
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецКлюча(), СокрЛП(НовыйКлючAPI), "КлючAPI");
		КонецЕсли;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

// Может ли текущий пользователь менять ключ API и адрес сервиса.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьПравоАдминистрирования() Экспорт
	Возврат ПравоДоступа("Администрирование", Метаданные);
КонецФункции

#КонецОбласти

#Область Подключение

// Проверяет ключ API: кто подключён и сколько страниц на балансе.
//
// Параметры:
//  КлючAPI - Строка - пустая строка, чтобы проверить сохранённый ключ.
//  АдресСервиса - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Текст - Строка - что показать пользователю.
//
Функция ПроверитьПодключение(Знач КлючAPI = "", Знач АдресСервиса = "") Экспорт
	Если ПустаяСтрока(КлючAPI) Тогда
		КлючAPI = КлючAPI();
	КонецЕсли;
	Если ПустаяСтрока(АдресСервиса) Тогда
		АдресСервиса = Настройки().АдресСервиса;
	КонецЕсли;
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Если ПустаяСтрока(КлючAPI) Тогда
		Результат.Текст = НСтр("ru = 'Ключ API не указан. Создайте ключ в личном кабинете my.typizer.ru (раздел «Ключи API») и вставьте его сюда.'");
		Возврат Результат;
	КонецЕсли;
	Подключение = НовоеПодключение(АдресСервиса, КлючAPI);

	Профиль = ТипизаторAPI.ПолучитьПрофиль(Подключение);
	Если Не Профиль.Успех Тогда
		Результат.Текст = ТекстОшибки(Профиль.Ошибка);
		Возврат Результат;
	КонецЕсли;
	ИмяОрганизации = ТипизаторAPIКлиентСервер.СтрокаИзЗначения(
		ТипизаторAPIКлиентСервер.ЗначениеПоля(Профиль.Данные, "organization.name"));

	ТекстБаланса = "";
	Баланс = ТипизаторAPI.ПолучитьБаланс(Подключение);
	Если Баланс.Успех Тогда
		Страниц = ТипизаторAPIКлиентСервер.ЧислоИзЗначения(ТипизаторAPIКлиентСервер.ЗначениеПоля(Баланс.Данные, "pages_available"));
		ТекстБаланса = СтрШаблон(НСтр("ru = ' Доступно страниц: %1.'"), Формат(Страниц, "ЧН=0; ЧРГ=' '; ЧГ=3,0"));
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Текст = СтрШаблон(НСтр("ru = 'Подключение работает. Организация в Typizer: %1.%2'"), ИмяОрганизации, ТекстБаланса);
	Возврат Результат;
КонецФункции

// Сохранённый ключ API. Читается в привилегированном режиме, на клиент не передаётся.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючAPI() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецКлюча(), "КлючAPI");
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ?(ТипЗнч(Ключ) = Тип("Строка"), Ключ, "");
КонецФункции

#КонецОбласти

#Область Распознавание

// Фоновое задание: отправляет файлы в Typizer и ждёт результатов.
// Вызывается через ДлительныеОперации.ВыполнитьВФоне.
//
// Параметры:
//  Параметры - Структура:
//   * Файлы - Массив из Структура:
//     ** Идентификатор - Строка - ключ строки в форме.
//     ** ИмяФайла - Строка
//     ** ДвоичныеДанные - ДвоичныеДанные
//     ** КлючИдемпотентности - Строка
//   * ВидДокумента - Строка - идентификатор из ТипизаторКлиентСервер.ВидыДокументов().
//  АдресРезультата - Строка - адрес временного хранилища для Массива результатов (см. НовыйРезультатРаспознавания).
//
Процедура РаспознатьДокументы(Параметры, АдресРезультата) Экспорт
	Настройки = Настройки();
	КлючAPI = КлючAPI();
	Результаты = Новый Массив;

	Если ПустаяСтрока(КлючAPI) Тогда
		Для Каждого Файл Из Параметры.Файлы Цикл
			Результат = НовыйРезультатРаспознавания(Файл.Идентификатор);
			Результат.Статус = ТипизаторКлиентСервер.СтатусОшибка();
			Результат.ТекстОшибки = НСтр("ru = 'Не указан ключ API. Откройте «Typizer: настройки».'");
			Результаты.Добавить(Результат);
		КонецЦикла;
		ПоместитьВоВременноеХранилище(Результаты, АдресРезультата);
		Возврат;
	КонецЕсли;

	Подключение = НовоеПодключение(Настройки.АдресСервиса, КлючAPI);
	ПараметрыПрогона = ТипизаторAPI.ПараметрыПрогона();
	ПараметрыПрогона.Схема = СхемаПервичногоДокумента();
	ПараметрыПрогона.Указания = ТипизаторКлиентСервер.УказаниеДляРаспознавания(Параметры.ВидДокумента);
	ПараметрыПрогона.Режим = ?(Настройки.ТочныйРежим, "precise", "standard");
	// wait=0: сервис сразу возвращает прогон, а результат забираем опросом — так файлы распознаются параллельно.
	ПараметрыПрогона.ОжиданиеСекунд = 0;
	Всего = Параметры.Файлы.Количество();

	// 1. Отправляем все файлы — сервис распознаёт их параллельно.
	Ожидающие = Новый Массив;
	Для Каждого Файл Из Параметры.Файлы Цикл
		Результат = НовыйРезультатРаспознавания(Файл.Идентификатор);
		Результаты.Добавить(Результат);
		ПараметрыПрогона.КлючИдемпотентности = Файл.КлючИдемпотентности;
		Прогон = ТипизаторAPI.СоздатьПрогон(Подключение, Файл.ДвоичныеДанные, Файл.ИмяФайла, ПараметрыПрогона);
		Результат.ИдентификаторПрогона = Прогон.ИдентификаторПрогона;
		ОбработатьПрогон(Результат, Прогон);
		Если Результат.Статус = ТипизаторКлиентСервер.СтатусРаспознаётся() Тогда
			Ожидающие.Добавить(Результат);
		Иначе
			СообщитьПрогрессРаспознавания(Результаты, Всего, Результат);
		КонецЕсли;
	КонецЦикла;

	// 2. Опрашиваем незавершённые прогоны, пока не будут готовы все.
	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + МаксимальноеВремяОжиданияСекунд() * 1000;
	Пока Ожидающие.Количество() > 0 Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() > Срок Тогда
			Для Каждого Результат Из Ожидающие Цикл
				Результат.Статус = ТипизаторКлиентСервер.СтатусОшибка();
				Результат.ТекстОшибки = НСтр("ru = 'Распознавание идёт дольше обычного. Нажмите «Повторить» позже — повторная отправка не спишет страницы второй раз.'");
				СообщитьПрогрессРаспознавания(Результаты, Всего, Результат);
			КонецЦикла;
			Прервать;
		КонецЕсли;
		ТипизаторAPI.Пауза(ИнтервалОпросаСекунд());
		Индекс = Ожидающие.ВГраница();
		Пока Индекс >= 0 Цикл
			Результат = Ожидающие[Индекс];
			Прогон = ТипизаторAPI.ПолучитьПрогон(Подключение, Результат.ИдентификаторПрогона);
			// Временные сбои (нет связи, 429, 5xx) не прерывают ожидание — опрашиваем дальше.
			Если Прогон.Ошибка = Неопределено Или Не ТипизаторAPIКлиентСервер.ЭтоВременнаяОшибка(Прогон.Ошибка) Тогда
				ОбработатьПрогон(Результат, Прогон);
			КонецЕсли;
			Если Результат.Статус <> ТипизаторКлиентСервер.СтатусРаспознаётся() Тогда
				Ожидающие.Удалить(Индекс);
				СообщитьПрогрессРаспознавания(Результаты, Всего, Результат);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЦикла;

	ПоместитьВоВременноеХранилище(Результаты, АдресРезультата);
КонецПроцедуры

// Пустой результат распознавания одного файла.
//
// Параметры:
//  Идентификатор - Строка - ключ строки в форме.
//
// Возвращаемое значение:
//  Структура:
//   * Идентификатор - Строка
//   * ИдентификаторПрогона - Строка
//   * Статус - Строка - см. ТипизаторКлиентСервер.Статус*().
//   * ТекстОшибки - Строка
//   * Документ - Структура, Неопределено - см. РазобратьРезультат().
//
Функция НовыйРезультатРаспознавания(Идентификатор) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", Идентификатор);
	Результат.Вставить("ИдентификаторПрогона", "");
	Результат.Вставить("Статус", ТипизаторКлиентСервер.СтатусРаспознаётся());
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Документ", Неопределено);
	Возврат Результат;
КонецФункции

// Переводит ответ сервиса (объект прогона) в распознанный документ.
//
// Параметры:
//  Output - Соответствие - поле output прогона.
//  Fields - Соответствие, Неопределено - поле fields прогона: статусы полей по путям.
//
// Возвращаемое значение:
//  Структура:
//   * КодВида - Строка - document_kind.
//   * ПредставлениеВида - Строка
//   * СтатусУПД - Строка
//   * Номер - Строка
//   * Дата - Дата
//   * НомерСчетаФактуры - Строка
//   * ДатаСчетаФактуры - Дата
//   * Продавец - Структура: Наименование, ИНН, КПП.
//   * Покупатель - Структура: Наименование, ИНН, КПП.
//   * НомерДоговора - Строка
//   * ДатаДоговора - Дата
//   * ЦеныВключаютНДС - Булево
//   * Строки - Массив из Структура: Наименование, Артикул, ЭтоУслуга, Единица, КодЕдиницы, Количество, Цена,
//                                   СуммаБезНДС, СтавкаНДС, СуммаНДС, Сумма.
//   * ИтогоБезНДС - Число
//   * ИтогоНДС - Число
//   * Итого - Число
//   * ЕстьСчетФактура - Булево - документ содержит счёт-фактуру (УПД статуса 1 или отдельный счёт-фактура).
//   * ПоляНаПроверку - Массив из Структура: Путь, Поле, Причина, Значение.
//
Функция РазобратьРезультат(Output, Fields) Экспорт
	Данные = ?(ТипЗнч(Output) = Тип("Соответствие"), Output, Новый Соответствие);
	Документ = Новый Структура;
	Документ.Вставить("КодВида", Строка_(Данные, "document_kind"));
	Документ.Вставить("СтатусУПД", Строка_(Данные, "upd_status"));
	Документ.Вставить("ПредставлениеВида", ТипизаторКлиентСервер.ПредставлениеВидаДокумента(Документ.КодВида, Документ.СтатусУПД));
	Документ.Вставить("Номер", Строка_(Данные, "document_number"));
	Документ.Вставить("Дата", ТипизаторAPIКлиентСервер.ДатаИзСтроки(Данные.Получить("document_date")));
	Документ.Вставить("НомерСчетаФактуры", Строка_(Данные, "invoice_factura_number"));
	Документ.Вставить("ДатаСчетаФактуры", ТипизаторAPIКлиентСервер.ДатаИзСтроки(Данные.Получить("invoice_factura_date")));
	Документ.Вставить("Продавец", Новый Структура("Наименование, ИНН, КПП",
		Строка_(Данные, "seller_name"),
		ТипизаторAPIКлиентСервер.ТолькоЦифрыИзСтроки(Данные.Получить("seller_inn")),
		ТипизаторAPIКлиентСервер.ТолькоЦифрыИзСтроки(Данные.Получить("seller_kpp"))));
	Документ.Вставить("Покупатель", Новый Структура("Наименование, ИНН, КПП",
		Строка_(Данные, "buyer_name"),
		ТипизаторAPIКлиентСервер.ТолькоЦифрыИзСтроки(Данные.Получить("buyer_inn")),
		ТипизаторAPIКлиентСервер.ТолькоЦифрыИзСтроки(Данные.Получить("buyer_kpp"))));
	Документ.Вставить("НомерДоговора", Строка_(Данные, "contract_number"));
	Документ.Вставить("ДатаДоговора", ТипизаторAPIКлиентСервер.ДатаИзСтроки(Данные.Получить("contract_date")));
	Документ.Вставить("ИтогоБезНДС", ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Данные.Получить("total_without_vat")));
	Документ.Вставить("ИтогоНДС", ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Данные.Получить("total_vat")));
	Документ.Вставить("Итого", ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Данные.Получить("total")));

	Строки = Новый Массив;
	Позиции = Данные.Получить("items");
	Если ТипЗнч(Позиции) = Тип("Массив") Тогда
		Для Каждого Позиция Из Позиции Цикл
			Если ТипЗнч(Позиция) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;
			Строки.Добавить(РазобратьСтроку(Позиция, Документ.КодВида));
		КонецЦикла;
	КонецЕсли;
	Документ.Вставить("Строки", Строки);

	ЦеныВключаютНДС = Данные.Получить("prices_include_vat");
	Если ТипЗнч(ЦеныВключаютНДС) <> Тип("Булево") Тогда
		ЦеныВключаютНДС = ЦеныВключаютНДСПоСтрокам(Строки);
	КонецЕсли;
	Документ.Вставить("ЦеныВключаютНДС", ЦеныВключаютНДС);
	Документ.Вставить("ЕстьСчетФактура", Документ.КодВида = "invoice_factura"
		Или (Документ.КодВида = "upd" И Документ.СтатусУПД <> "2")
		Или Не ПустаяСтрока(Документ.НомерСчетаФактуры));
	Документ.Вставить("ПоляНаПроверку", ПоляНаПроверку(Fields, Данные));
	Возврат Документ;
КонецФункции

#КонецОбласти

#КонецОбласти

