#Область Распознавание_

Функция СхемаПервичногоДокумента()
	Возврат ПолучитьОбщийМакет("ТипизаторСхемаПервичногоДокумента").ПолучитьТекст();
КонецФункции

// Переносит состояние прогона (результат ТипизаторAPI) в результат распознавания строки.
Процедура ОбработатьПрогон(Результат, Прогон)
	Если Прогон.Ошибка <> Неопределено Тогда
		Результат.Статус = ТипизаторКлиентСервер.СтатусОшибка();
		Результат.ТекстОшибки = ТекстОшибки(Прогон.Ошибка);
	ИначеЕсли Прогон.Завершен Тогда
		Документ = РазобратьРезультат(Прогон.Данные, Прогон.Поля);
		Результат.Документ = Документ;
		Если Документ.ПоляНаПроверку.Количество() = 0 Тогда
			Результат.Статус = ТипизаторКлиентСервер.СтатусГотово();
		Иначе
			Результат.Статус = ТипизаторКлиентСервер.СтатусТребуетПроверки();
		КонецЕсли;
	Иначе
		Результат.Статус = ТипизаторКлиентСервер.СтатусРаспознаётся();
	КонецЕсли;
КонецПроцедуры

Процедура СообщитьПрогрессРаспознавания(Результаты, Всего, Результат)
	Готово = 0;
	Для Каждого Элемент Из Результаты Цикл
		Если Элемент.Статус <> ТипизаторКлиентСервер.СтатусРаспознаётся() Тогда
			Готово = Готово + 1;
		КонецЕсли;
	КонецЦикла;
	Процент = ?(Всего = 0, 100, Окр(100 * Готово / Всего));
	Текст = СтрШаблон(НСтр("ru = 'Распознано %1 из %2'"), Формат(Готово, "ЧН=0; ЧГ=0"), Формат(Всего, "ЧН=0; ЧГ=0"));
	ДлительныеОперации.СообщитьПрогресс(Процент, Текст, Новый Структура("Результат", Результат));
КонецПроцедуры

Функция РазобратьСтроку(Позиция, КодВида)
	Строка = Новый Структура;
	Строка.Вставить("Наименование", Строка_(Позиция, "name"));
	Строка.Вставить("Артикул", Строка_(Позиция, "article"));
	ЭтоУслуга = Позиция.Получить("is_service");
	Строка.Вставить("ЭтоУслуга", ?(ТипЗнч(ЭтоУслуга) = Тип("Булево"), ЭтоУслуга, КодВида = "act"));
	Строка.Вставить("Единица", Строка_(Позиция, "unit"));
	Строка.Вставить("КодЕдиницы", ТипизаторAPIКлиентСервер.ТолькоЦифрыИзСтроки(Позиция.Получить("unit_code")));
	Строка.Вставить("Количество", ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Позиция.Получить("quantity")));
	Строка.Вставить("Цена", ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Позиция.Получить("price")));
	Строка.Вставить("СуммаБезНДС", ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Позиция.Получить("amount_without_vat")));
	Строка.Вставить("СтавкаНДС", ТипизаторКлиентСервер.КодСтавкиНДС(Позиция.Получить("vat_rate")));
	Строка.Вставить("СуммаНДС", ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Позиция.Получить("vat_amount")));
	Строка.Вставить("Сумма", ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Позиция.Получить("amount")));
	Если Строка.Количество = 0 И Строка.Сумма <> 0 Тогда
		Строка.Количество = 1;
	КонецЕсли;
	Если Строка.Цена = 0 И Строка.Количество <> 0 Тогда
		Строка.Цена = Окр(Строка.Сумма / Строка.Количество, 2);
	КонецЕсли;
	Если Строка.СуммаБезНДС = 0 Тогда
		Строка.СуммаБезНДС = Строка.Сумма - Строка.СуммаНДС;
	КонецЕсли;
	Возврат Строка;
КонецФункции

// Цены считаются «с НДС», если цена × количество ближе к сумме с НДС, чем к сумме без НДС.
Функция ЦеныВключаютНДСПоСтрокам(Строки)
	Для Каждого Строка Из Строки Цикл
		Если Строка.СуммаНДС = 0 Или Строка.Количество = 0 Или Строка.Цена = 0 Тогда
			Продолжить;
		КонецЕсли;
		Стоимость = Строка.Цена * Строка.Количество;
		Возврат Макс(Стоимость - Строка.Сумма, Строка.Сумма - Стоимость)
			< Макс(Стоимость - Строка.СуммаБезНДС, Строка.СуммаБезНДС - Стоимость);
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПоляНаПроверку(Fields, Данные)
	Результат = Новый Массив;
	// Отсутствие этих полей не мешает создать документ, поэтому «не найдено» по ним не показываем.
	Необязательные = СтрРазделить("upd_status,invoice_factura_number,invoice_factura_date,seller_address,seller_bik,"
		+ "seller_account,contract_number,contract_date,currency,prices_include_vat,total_without_vat,total_vat,"
		+ "article,is_service,unit,unit_code,amount_without_vat,vat_amount,buyer_kpp,seller_kpp", ",");
	Для Каждого Поле Из ТипизаторAPIКлиентСервер.ПоляНаПроверку(Fields) Цикл
		ЧастиПути = СтрРазделить(Поле.Путь, ".");
		ИмяПоля = ЧастиПути[ЧастиПути.ВГраница()];
		Если Поле.Статус = "missing" И Необязательные.Найти(ИмяПоля) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура;
		Описание.Вставить("Путь", Поле.Путь);
		Описание.Вставить("Поле", ТипизаторКлиентСервер.ПредставлениеПоля(Поле.Путь));
		Описание.Вставить("Причина", ТипизаторКлиентСервер.ПредставлениеПричиныПроверки(Поле.Статус, Поле.Причина));
		Описание.Вставить("Значение", ПредставлениеЗначения(ТипизаторAPIКлиентСервер.ЗначениеПоля(Данные, Поле.Путь)));
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПредставлениеЗначения(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧДЦ=2; ЧГ=3,0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Или ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Возврат ТипизаторAPIКлиентСервер.СтрокаИзЗначения(Значение);
КонецФункции

Функция Строка_(Данные, Имя)
	Возврат ТипизаторAPIКлиентСервер.СтрокаИзЗначения(Данные.Получить(Имя));
КонецФункции

