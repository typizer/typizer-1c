///////////////////////////////////////////////////////////////////////////////////////////////////////
// Typizer SDK для 1С:Предприятия 8.3 (платформа 8.3.17 и новее).
// Общие функции клиента и сервера: чтение полей результата, приведение значений, тексты ошибок.
// Не зависит от БСП и объектов конфигурации. Документация: https://docs.typizer.ru/how-to/1c-sdk
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область Константы

// Версия SDK — передаётся в заголовке User-Agent.
//
// Возвращаемое значение:
//  Строка
//
Функция ВерсияSDK() Экспорт
	Возврат "1.1.1";
КонецФункции

// Адрес API Typizer по умолчанию.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресСервисаПоУмолчанию() Экспорт
	Возврат "https://api.typizer.ru";
КонецФункции

// Адрес личного кабинета: ключи API, баланс, типизаторы.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресЛичногоКабинета() Экспорт
	Возврат "https://my.typizer.ru";
КонецФункции

// Адрес сервиса в каноническом виде: со схемой https:// (если не указана) и без завершающего «/».
//
// Параметры:
//  Адрес - Строка - пустая строка означает адрес по умолчанию.
//
// Возвращаемое значение:
//  Строка
//
Функция НормализованныйАдресСервиса(Знач Адрес) Экспорт
	Адрес = СокрЛП(СтрокаИзЗначения(Адрес));
	Если ПустаяСтрока(Адрес) Тогда
		Возврат АдресСервисаПоУмолчанию();
	КонецЕсли;
	Если Не СтрНачинаетсяС(НРег(Адрес), "http://") И Не СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Адрес = "https://" + Адрес;
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Возврат Адрес;
КонецФункции

// Наибольший размер файла, который принимает сервис, в байтах (50 МиБ).
//
// Возвращаемое значение:
//  Число
//
Функция МаксимальныйРазмерФайла() Экспорт
	Возврат 52428800;
КонецФункции

#КонецОбласти

#Область ЧтениеРезультата

// Значение поля результата распознавания по пути.
//
// Параметры:
//  Данные - Соответствие, Массив - результат (Результат.Данные из ТипизаторAPI) или его часть.
//  Путь - Строка - имя поля или путь: "document_number", "seller.inn", "items[0].amount".
//
// Возвращаемое значение:
//  Произвольный - Строка, Число, Булево, Соответствие, Массив; Неопределено, если поля нет или в нём null.
//
// Пример:
//  Сумма = ТипизаторAPIКлиентСервер.ЗначениеПоля(Результат.Данные, "items[0].amount");
//
Функция ЗначениеПоля(Данные, Знач Путь) Экспорт
	Текущее = Данные;
	Путь = СтрЗаменить(СтрЗаменить(Путь, "[", "."), "]", "");
	Для Каждого Часть Из СтрРазделить(Путь, ".", Ложь) Цикл
		Если ТипЗнч(Текущее) = Тип("Соответствие") Тогда
			Текущее = Текущее.Получить(Часть);
		ИначеЕсли ТипЗнч(Текущее) = Тип("Массив") И ТолькоЦифры(Часть) Тогда
			Индекс = Число(Часть);
			Если Индекс > Текущее.ВГраница() Тогда
				Возврат Неопределено;
			КонецЕсли;
			Текущее = Текущее[Индекс];
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если Текущее = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Текущее;
КонецФункции

// Поля, которые не прошли проверки сервиса: их стоит показать человеку.
//
// Параметры:
//  Поля - Соответствие, Неопределено - Результат.Поля из ТипизаторAPI (поле fields прогона).
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Путь - Строка - путь поля, например "seller_inn" или "items[2].amount".
//   * Статус - Строка - "warn" (значение есть, но не прошло проверку) или "missing" (не найдено в документе).
//   * Причина - Строка - причина "warn": "checksum_mismatch", "invalid_format", "sum_mismatch",
//                        "implausible_date", "no_source", "code_mismatch" (значение расходится со штрихкодом
//                        или QR-кодом на документе); пустая строка для "missing".
//
Функция ПоляНаПроверку(Поля) Экспорт
	Результат = Новый Массив;
	Если ТипЗнч(Поля) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Поля Цикл
		Поле = КлючИЗначение.Значение;
		Если ТипЗнч(Поле) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Статус = СтрокаИзЗначения(Поле.Получить("status"));
		Если ПустаяСтрока(Статус) Или Статус = "ok" Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Путь, Статус, Причина",
			КлючИЗначение.Ключ, Статус, СтрокаИзЗначения(Поле.Получить("reason"))));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПриведениеЗначений

// Приводит значение из результата к числу.
//
// Параметры:
//  Значение - Произвольный - число, строка ("1 234,50") или Неопределено.
//
// Возвращаемое значение:
//  Число - 0, если значение не число.
//
Функция ЧислоИзЗначения(Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = СтрЗаменить(СокрЛП(Значение), " ", "");
		Текст = СтрЗаменить(Текст, Символы.НПП, "");
		Текст = СтрЗаменить(Текст, ",", ".");
		Если ПустаяСтрока(Текст) Тогда
			Возврат 0;
		КонецЕсли;
		ОписаниеЧисла = Новый ОписаниеТипов("Число");
		Результат = ОписаниеЧисла.ПривестиЗначение(Текст);
		Возврат ?(Результат = Неопределено, 0, Результат);
	КонецЕсли;
	Возврат 0;
КонецФункции

// Приводит дату ISO 8601 (ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс) к значению типа Дата.
//
// Параметры:
//  Значение - Строка, Неопределено
//
// Возвращаемое значение:
//  Дата - пустая дата, если строку не удалось разобрать.
//
Функция ДатаИзСтроки(Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Текст = СокрЛП(Значение);
	Если СтрДлина(Текст) < 10 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Цифры = СтрЗаменить(Лев(Текст, 10), "-", "");
	Если СтрДлина(Цифры) <> 8 Или Не ТолькоЦифры(Цифры) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	ОписаниеДаты = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	Возврат ОписаниеДаты.ПривестиЗначение(Цифры);
КонецФункции

// Строковое значение из результата без пробелов по краям.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Строка - пустая строка для Неопределено и Null.
//
Функция СтрокаИзЗначения(Значение) Экспорт
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

// Оставляет в строке только цифры (ИНН, КПП, БИК, коды).
//
// Параметры:
//  Значение - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ТолькоЦифрыИзСтроки(Значение) Экспорт
	Текст = СтрокаИзЗначения(Значение);
	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Файлы

// Расширение файла без точки в нижнем регистре.
//
// Параметры:
//  ИмяФайла - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция РасширениеФайла(ИмяФайла) Экспорт
	Части = СтрРазделить(ИмяФайла, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	Возврат НРег(Части[Части.ВГраница()]);
КонецФункции

// Тип содержимого (MIME) файла по его расширению.
//
// Параметры:
//  ИмяФайла - Строка
//
// Возвращаемое значение:
//  Строка - например "application/pdf"; "application/octet-stream", если расширение незнакомо.
//
Функция ТипСодержимогоФайла(ИмяФайла) Экспорт
	Расширение = РасширениеФайла(ИмяФайла);
	Если Расширение = "pdf" Тогда
		Возврат "application/pdf";
	ИначеЕсли Расширение = "png" Тогда
		Возврат "image/png";
	ИначеЕсли Расширение = "jpg" Или Расширение = "jpeg" Тогда
		Возврат "image/jpeg";
	ИначеЕсли Расширение = "tif" Или Расширение = "tiff" Тогда
		Возврат "image/tiff";
	ИначеЕсли Расширение = "bmp" Тогда
		Возврат "image/bmp";
	ИначеЕсли Расширение = "webp" Тогда
		Возврат "image/webp";
	ИначеЕсли Расширение = "docx" Тогда
		Возврат "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
	ИначеЕсли Расширение = "xlsx" Тогда
		Возврат "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
	ИначеЕсли Расширение = "txt" Тогда
		Возврат "text/plain";
	КонецЕсли;
	Возврат "application/octet-stream";
КонецФункции

#КонецОбласти

#Область ТекстыОшибок

// Понятный текст ошибки для пользователя 1С — без кодов ответа и терминов API.
//
// Параметры:
//  КодСостояния - Число - код ответа сервиса; 0, если ответа не было.
//  КодОшибки - Строка - код ошибки сервиса ("insufficient_balance", …) или SDK ("connection_failed", "timeout", …).
//  Подробности - Строка - пояснение сервиса или текст ошибки соединения.
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстОшибки(КодСостояния, КодОшибки = "", Подробности = "") Экспорт
	Если КодОшибки = "api_key_missing" Тогда
		Возврат НСтр("ru = 'Не указан ключ API Typizer. Создайте ключ в личном кабинете my.typizer.ru (раздел «Ключи API»).'");
	ИначеЕсли КодОшибки = "invalid_argument" Тогда
		Возврат СтрШаблон(НСтр("ru = 'Неверные параметры вызова Typizer: %1'"), Подробности);
	ИначеЕсли КодОшибки = "timeout" Тогда
		Возврат НСтр("ru = 'Распознавание идёт дольше обычного. Запросите результат позже — повторная отправка с тем же ключом идемпотентности не спишет страницы второй раз.'");
	ИначеЕсли КодОшибки = "output_expired" Тогда
		Возврат НСтр("ru = 'Результат распознавания уже удалён по сроку хранения. Отправьте файл ещё раз.'");
	ИначеЕсли КодОшибки = "invalid_response" Тогда
		Возврат НСтр("ru = 'Сервис Typizer вернул неожиданный ответ. Повторите через несколько минут.'");
	ИначеЕсли КодОшибки = "client_error" Тогда
		Возврат СтрШаблон(НСтр("ru = 'Не удалось выполнить запрос к Typizer: %1'"), Подробности);
	ИначеЕсли КодСостояния = 0 Или КодОшибки = "connection_failed" Тогда
		Возврат НСтр("ru = 'Нет связи с сервисом Typizer. Проверьте доступ к api.typizer.ru и настройки прокси-сервера.'");
	ИначеЕсли КодСостояния = 401 Или КодОшибки = "unauthorized" Тогда
		Возврат НСтр("ru = 'Ключ API не подходит или отключён. Проверьте ключ или создайте новый в личном кабинете my.typizer.ru.'");
	ИначеЕсли КодСостояния = 402 Или КодОшибки = "insufficient_balance" Тогда
		Возврат НСтр("ru = 'На балансе Typizer закончились страницы. Пополните баланс в личном кабинете my.typizer.ru и повторите.'");
	ИначеЕсли КодОшибки = "insufficient_scope" Тогда
		Возврат НСтр("ru = 'У ключа API нет нужного права. Создайте в личном кабинете ключ с правами «runs:write» и «runs:read».'");
	ИначеЕсли КодСостояния = 403 Или КодОшибки = "forbidden" Тогда
		Возврат НСтр("ru = 'Доступ запрещён. Проверьте, что ключ API относится к вашей организации в Typizer.'");
	ИначеЕсли КодСостояния = 404 Или КодОшибки = "not_found" Тогда
		Возврат НСтр("ru = 'Прогон или типизатор не найден. Проверьте идентификатор.'");
	ИначеЕсли КодСостояния = 413 Или КодОшибки = "file_too_large" Тогда
		Возврат НСтр("ru = 'Файл больше 50 МБ. Разделите документ на части или уменьшите разрешение скана.'");
	ИначеЕсли КодСостояния = 415 Или КодОшибки = "unsupported_file_type" Тогда
		Возврат НСтр("ru = 'Такой тип файла не поддерживается. Загрузите PDF, JPG или PNG.'");
	ИначеЕсли КодОшибки = "too_many_pages" Тогда
		Возврат НСтр("ru = 'В документе слишком много страниц. Разделите его на части.'");
	ИначеЕсли КодОшибки = "document_unreadable" Тогда
		Возврат НСтр("ru = 'Документ не читается: файл повреждён, защищён паролем или скан слишком нечёткий.'");
	ИначеЕсли КодОшибки = "extraction_failed" Тогда
		Возврат НСтр("ru = 'Не удалось распознать документ. Повторите попытку; если ошибка повторяется — пришлите файл в поддержку Typizer.'");
	ИначеЕсли КодОшибки = "invalid_schema" Или КодОшибки = "unsupported_schema_feature" Тогда
		Возврат СтрШаблон(НСтр("ru = 'Схема извлечения не подходит: %1'"), Подробности);
	ИначеЕсли КодОшибки = "idempotency_conflict" Тогда
		Возврат НСтр("ru = 'Этот ключ идемпотентности уже использован для другого запроса или запрос ещё выполняется. Для нового документа нужен новый ключ.'");
	ИначеЕсли КодСостояния = 429 Или КодОшибки = "rate_limited" Тогда
		Возврат НСтр("ru = 'Слишком много запросов подряд. Подождите минуту и повторите.'");
	ИначеЕсли КодСостояния = 408 Тогда
		Возврат НСтр("ru = 'Файл передавался слишком долго. Проверьте скорость интернета и повторите.'");
	ИначеЕсли КодСостояния >= 500 Или КодОшибки = "upstream_unavailable" Или КодОшибки = "internal_error" Тогда
		Возврат НСтр("ru = 'Сервис Typizer временно недоступен. Повторите через несколько минут.'");
	КонецЕсли;
	Если Не ПустаяСтрока(Подробности) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Сервис Typizer вернул ошибку: %1'"), Подробности);
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Сервис Typizer вернул ошибку (код %1).'"), Формат(КодСостояния, "ЧГ=0"));
КонецФункции

// Можно ли повторить запрос позже с тем же результатом: нет связи, перегрузка, временный сбой сервиса.
//
// Параметры:
//  Ошибка - Структура - Результат.Ошибка из ТипизаторAPI.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоВременнаяОшибка(Ошибка) Экспорт
	Если ТипЗнч(Ошибка) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Ошибка.Код = "connection_failed" Или Ошибка.Код = "timeout" Или Ошибка.КодСостояния = 429
		Или Ошибка.КодСостояния = 408 Или Ошибка.КодСостояния >= 500;
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТолькоЦифры(Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

#КонецОбласти
