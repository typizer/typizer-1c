///////////////////////////////////////////////////////////////////////////////////////////////////////
// Typizer: распознавание первичных документов.
// Общие функции клиента и сервера: виды документов, статусы, разбор значений, тексты ошибок.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область Константы

// Версия расширения — передаётся в заголовке User-Agent и показывается в настройках.
//
// Возвращаемое значение:
//  Строка
//
Функция ВерсияРасширения() Экспорт
	Возврат "1.0.0";
КонецФункции

// Расширения файлов, которые принимает сервис (в нижнем регистре, без точки).
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ДопустимыеРасширенияФайлов() Экспорт
	Возврат СтрРазделить("pdf,jpg,jpeg,png,tif,tiff,bmp,webp", ",");
КонецФункции

// Фильтр для диалога выбора файлов.
//
// Возвращаемое значение:
//  Строка
//
Функция ФильтрДиалогаВыбораФайлов() Экспорт
	Маски = Новый Массив;
	Для Каждого Расширение Из ДопустимыеРасширенияФайлов() Цикл
		Маски.Добавить("*." + Расширение);
	КонецЦикла;
	СтрокаМасок = СтрСоединить(Маски, ";");
	Возврат СтрШаблон(НСтр("ru = 'Сканы и PDF (%1)|%1'"), СтрокаМасок);
КонецФункции

// Наибольший размер файла, который принимает сервис, в байтах (50 МиБ).
//
// Возвращаемое значение:
//  Число
//
Функция МаксимальныйРазмерФайла() Экспорт
	Возврат 52428800;
КонецФункции

#КонецОбласти

#Область ВидыДокументов

// Виды документов, из которых пользователь выбирает «что за документ».
//
// Возвращаемое значение:
//  СписокЗначений - значение: идентификатор вида, представление: текст для пользователя.
//
Функция ВидыДокументов() Экспорт
	Список = Новый СписокЗначений;
	Список.Добавить(ВидАвтоопределение(), НСтр("ru = 'Определить автоматически'"));
	Список.Добавить("Накладная", НСтр("ru = 'Поступление товаров (накладная, ТОРГ-12)'"));
	Список.Добавить("УПД", НСтр("ru = 'УПД'"));
	Список.Добавить("Акт", НСтр("ru = 'Акт (работы, услуги)'"));
	Список.Добавить("СчетПоставщика", НСтр("ru = 'Счёт от поставщика'"));
	Возврат Список;
КонецФункции

// Идентификатор вида «Определить автоматически».
//
// Возвращаемое значение:
//  Строка
//
Функция ВидАвтоопределение() Экспорт
	Возврат "Авто";
КонецФункции

// Подсказка для распознавания, когда пользователь сам указал вид документа.
//
// Параметры:
//  ВидДокумента - Строка - идентификатор из ВидыДокументов().
//
// Возвращаемое значение:
//  Строка - пустая строка для автоопределения.
//
Функция УказаниеДляРаспознавания(ВидДокумента) Экспорт
	Если ВидДокумента = "Накладная" Тогда
		Возврат "Это товарная накладная (ТОРГ-12 или аналог): document_kind = torg12.";
	ИначеЕсли ВидДокумента = "УПД" Тогда
		Возврат "Это универсальный передаточный документ: document_kind = upd. Укажите статус УПД (1 или 2).";
	ИначеЕсли ВидДокумента = "Акт" Тогда
		Возврат "Это акт выполненных работ или оказанных услуг: document_kind = act, все строки — услуги.";
	ИначеЕсли ВидДокумента = "СчетПоставщика" Тогда
		Возврат "Это счёт на оплату от поставщика: document_kind = invoice.";
	КонецЕсли;
	Возврат "";
КонецФункции

// Представление распознанного вида документа (document_kind) для пользователя.
//
// Параметры:
//  КодВида - Строка - значение поля document_kind.
//  СтатусУПД - Строка - значение поля upd_status.
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеВидаДокумента(КодВида, СтатусУПД = "") Экспорт
	Если КодВида = "upd" Тогда
		Если ЗначениеЗаполнено(СтатусУПД) Тогда
			Возврат СтрШаблон(НСтр("ru = 'УПД (статус %1)'"), СтатусУПД);
		КонецЕсли;
		Возврат НСтр("ru = 'УПД'");
	ИначеЕсли КодВида = "torg12" Тогда
		Возврат НСтр("ru = 'Накладная'");
	ИначеЕсли КодВида = "act" Тогда
		Возврат НСтр("ru = 'Акт'");
	ИначеЕсли КодВида = "invoice" Тогда
		Возврат НСтр("ru = 'Счёт на оплату'");
	ИначеЕсли КодВида = "invoice_factura" Тогда
		Возврат НСтр("ru = 'Счёт-фактура'");
	КонецЕсли;
	Возврат НСтр("ru = 'Другой документ'");
КонецФункции

// Какой документ 1С создать по распознанному документу.
//
// Параметры:
//  ВидДокумента - Строка - выбор пользователя (идентификатор из ВидыДокументов()).
//  КодВида - Строка - распознанный document_kind.
//
// Возвращаемое значение:
//  Строка - "ПоступлениеТоваровУслуг" или "СчетНаОплатуПоставщика".
//
Функция СоздаваемыйДокумент(ВидДокумента, КодВида) Экспорт
	Если ВидДокумента = "СчетПоставщика" Тогда
		Возврат "СчетНаОплатуПоставщика";
	ИначеЕсли ВидДокумента = ВидАвтоопределение() И КодВида = "invoice" Тогда
		Возврат "СчетНаОплатуПоставщика";
	КонецЕсли;
	Возврат "ПоступлениеТоваровУслуг";
КонецФункции

#КонецОбласти

#Область Статусы

// Статус строки: файл добавлен, ещё не отправлен.
Функция СтатусОжидает() Экспорт
	Возврат "Ожидает";
КонецФункции

// Статус строки: документ отправлен и распознаётся.
Функция СтатусРаспознаётся() Экспорт
	Возврат "Распознаётся";
КонецФункции

// Статус строки: все реквизиты прошли проверки.
Функция СтатусГотово() Экспорт
	Возврат "Готово";
КонецФункции

// Статус строки: распознано, но часть реквизитов нужно проверить глазами.
Функция СтатусТребуетПроверки() Экспорт
	Возврат "ТребуетПроверки";
КонецФункции

// Статус строки: распознать не удалось.
Функция СтатусОшибка() Экспорт
	Возврат "Ошибка";
КонецФункции

// Статус строки: документ 1С создан.
Функция СтатусСоздан() Экспорт
	Возврат "Создан";
КонецФункции

// Представление статуса для колонки «Статус».
//
// Параметры:
//  Статус - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеСтатуса(Статус) Экспорт
	Если Статус = СтатусОжидает() Тогда
		Возврат НСтр("ru = 'Ожидает'");
	ИначеЕсли Статус = СтатусРаспознаётся() Тогда
		Возврат НСтр("ru = 'Распознаётся…'");
	ИначеЕсли Статус = СтатусГотово() Тогда
		Возврат НСтр("ru = 'Готово'");
	ИначеЕсли Статус = СтатусТребуетПроверки() Тогда
		Возврат НСтр("ru = 'Требует проверки'");
	ИначеЕсли Статус = СтатусОшибка() Тогда
		Возврат НСтр("ru = 'Ошибка'");
	ИначеЕсли Статус = СтатусСоздан() Тогда
		Возврат НСтр("ru = 'Документ создан'");
	КонецЕсли;
	Возврат Статус;
КонецФункции

// Можно ли по строке со статусом создавать документ 1С.
//
// Параметры:
//  Статус - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция МожноСоздатьДокумент(Статус) Экспорт
	Возврат Статус = СтатусГотово() Или Статус = СтатусТребуетПроверки();
КонецФункции

#КонецОбласти

#Область РазборЗначений

// Ставка НДС из распознанной строки — в виде кода, не зависящего от конфигурации.
//
// Параметры:
//  Значение - Строка - например "22%", "20 %", "без НДС", "10/110".
//
// Возвращаемое значение:
//  Строка - "22", "20", "10", "7", "5", "0", "БезНДС", "22/122", "20/120", "10/110" или "" (не распознана).
//
Функция КодСтавкиНДС(Значение) Экспорт
	Текст = НРег(ТипизаторAPIКлиентСервер.СтрокаИзЗначения(Значение));
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, "%", "");
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	ИначеЕсли СтрНайти(Текст, "без") > 0 Тогда
		Возврат "БезНДС";
	КонецЕсли;
	Для Каждого Код Из СтрРазделить("22/122,20/120,10/110", ",") Цикл
		Если Текст = Код Тогда
			Возврат Код;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Код Из СтрРазделить("22,20,10,7,5,0", ",") Цикл
		Если Текст = Код Или Текст = Код + ",0" Или Текст = Код + ".0" Тогда
			Возврат Код;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Представление кода ставки НДС для пользователя.
//
// Параметры:
//  Код - Строка - результат КодСтавкиНДС().
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеСтавкиНДС(Код) Экспорт
	Если Код = "БезНДС" Тогда
		Возврат НСтр("ru = 'Без НДС'");
	ИначеЕсли ПустаяСтрока(Код) Тогда
		Возврат "";
	ИначеЕсли СтрНайти(Код, "/") > 0 Тогда
		Возврат Код;
	КонецЕсли;
	Возврат Код + "%";
КонецФункции

// Нормализует наименование для сравнения: верхний регистр, без кавычек и лишних пробелов.
//
// Параметры:
//  Наименование - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция НормализованноеНаименование(Наименование) Экспорт
	Текст = ВРег(ТипизаторAPIКлиентСервер.СтрокаИзЗначения(Наименование));
	Для Каждого Символ Из СтрРазделить("""|«|»|“|”|'|" + Символы.Таб + "|" + Символы.ПС + "|" + Символы.ВК, "|") Цикл
		Текст = СтрЗаменить(Текст, Символ, " ");
	КонецЦикла;
	Текст = СтрЗаменить(Текст, "Ё", "Е");
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Текст);
КонецФункции

// Ключ строки документа для запоминания сопоставления номенклатуры.
// Артикул поставщика надёжнее наименования, поэтому он в приоритете.
//
// Параметры:
//  Артикул - Строка
//  Наименование - Строка
//
// Возвращаемое значение:
//  Строка - не длиннее 150 символов.
//
Функция КлючСтрокиНоменклатуры(Артикул, Наименование) Экспорт
	АртикулНормализованный = НормализованноеНаименование(Артикул);
	Если Не ПустаяСтрока(АртикулНормализованный) Тогда
		Возврат Лев("А:" + АртикулНормализованный, 150);
	КонецЕсли;
	Возврат Лев("Н:" + НормализованноеНаименование(Наименование), 150);
КонецФункции

#КонецОбласти

#Область ПредставлениеПолей

// Понятное бухгалтеру название поля распознанного документа.
//
// Параметры:
//  Путь - Строка - путь поля в ответе сервиса, например "seller_inn" или "items[2].amount".
//
// Возвращаемое значение:
//  Строка - например "ИНН продавца" или "Строка 3: сумма".
//
Функция ПредставлениеПоля(Путь) Экспорт
	Если СтрНачинаетсяС(Путь, "items[") Тогда
		ПозицияСкобки = СтрНайти(Путь, "]");
		НомерСтроки = ТипизаторAPIКлиентСервер.ЧислоИзЗначения(Сред(Путь, 7, ПозицияСкобки - 7)) + 1;
		ИмяПоля = Сред(Путь, ПозицияСкобки + 2);
		Возврат СтрШаблон(НСтр("ru = 'Строка %1: %2'"), Формат(НомерСтроки, "ЧГ=0"), НРег(НазваниеПоля(ИмяПоля)));
	КонецЕсли;
	Возврат НазваниеПоля(Путь);
КонецФункции

// Почему поле требует проверки — понятным языком.
//
// Параметры:
//  Статус - Строка - "warn" или "missing".
//  Причина - Строка - причина warn из ответа сервиса.
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеПричиныПроверки(Статус, Причина) Экспорт
	Если Статус = "missing" Тогда
		Возврат НСтр("ru = 'не найдено в документе'");
	ИначеЕсли Причина = "checksum_mismatch" Тогда
		Возврат НСтр("ru = 'не сходится контрольное число'");
	ИначеЕсли Причина = "invalid_format" Тогда
		Возврат НСтр("ru = 'неверный формат'");
	ИначеЕсли Причина = "sum_mismatch" Тогда
		Возврат НСтр("ru = 'итог не равен сумме строк'");
	ИначеЕсли Причина = "implausible_date" Тогда
		Возврат НСтр("ru = 'неправдоподобная дата'");
	ИначеЕсли Причина = "no_source" Тогда
		Возврат НСтр("ru = 'не удалось найти значение на странице'");
	КонецЕсли;
	Возврат НСтр("ru = 'проверьте значение'");
КонецФункции

#КонецОбласти

#Область ТекстыОшибок

// Текст ошибки сервиса для бухгалтера: без кодов HTTP и терминов API.
//
// Параметры:
//  КодСостояния - Число - код ответа HTTP; 0, если ответа не было.
//  КодОшибки - Строка - поле code из ответа сервиса.
//  Подробности - Строка - поле detail из ответа сервиса или текст ошибки соединения.
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстОшибкиСервиса(КодСостояния, КодОшибки = "", Подробности = "") Экспорт
	// Тексты для бухгалтера со ссылками на формы расширения; остальные — общие тексты Typizer SDK.
	Если КодОшибки = "api_key_missing" Тогда
		Возврат НСтр("ru = 'Не указан ключ API. Откройте «Typizer: настройки».'");
	ИначеЕсли КодСостояния = 0 И (ПустаяСтрока(КодОшибки) Или КодОшибки = "connection_failed") Тогда
		Возврат НСтр("ru = 'Нет связи с сервисом Typizer. Проверьте подключение к интернету и настройки прокси-сервера (Администрирование → Интернет-поддержка и сервисы).'");
	ИначеЕсли КодСостояния = 401 Тогда
		Возврат НСтр("ru = 'Ключ API не подходит или отключён. Откройте «Typizer: настройки» и вставьте действующий ключ из личного кабинета my.typizer.ru.'");
	КонецЕсли;
	Возврат ТипизаторAPIКлиентСервер.ТекстОшибки(КодСостояния, КодОшибки, Подробности);
КонецФункции

#КонецОбласти

#Область Файлы

// Имя файла без каталога.
//
// Параметры:
//  ПолноеИмя - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяФайлаБезКаталога(ПолноеИмя) Экспорт
	Текст = СтрЗаменить(ПолноеИмя, "\", "/");
	Части = СтрРазделить(Текст, "/", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат Части[Части.ВГраница()];
КонецФункции

// Можно ли отправить файл на распознавание (проверка по расширению).
//
// Параметры:
//  ИмяФайла - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ФайлПоддерживается(ИмяФайла) Экспорт
	Возврат ДопустимыеРасширенияФайлов().Найти(ТипизаторAPIКлиентСервер.РасширениеФайла(ИмяФайла)) <> Неопределено;
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НазваниеПоля(ИмяПоля)
	Названия = Новый Соответствие;
	Названия.Вставить("document_kind", НСтр("ru = 'Вид документа'"));
	Названия.Вставить("upd_status", НСтр("ru = 'Статус УПД'"));
	Названия.Вставить("document_number", НСтр("ru = 'Номер документа'"));
	Названия.Вставить("document_date", НСтр("ru = 'Дата документа'"));
	Названия.Вставить("invoice_factura_number", НСтр("ru = 'Номер счёта-фактуры'"));
	Названия.Вставить("invoice_factura_date", НСтр("ru = 'Дата счёта-фактуры'"));
	Названия.Вставить("seller_name", НСтр("ru = 'Продавец'"));
	Названия.Вставить("seller_inn", НСтр("ru = 'ИНН продавца'"));
	Названия.Вставить("seller_kpp", НСтр("ru = 'КПП продавца'"));
	Названия.Вставить("seller_address", НСтр("ru = 'Адрес продавца'"));
	Названия.Вставить("seller_bik", НСтр("ru = 'БИК банка продавца'"));
