///////////////////////////////////////////////////////////////////////////////////////////////////////
// Typizer: распознавание первичных документов.
// Клиент: открытие форм из команд разделов и форм списков.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Открывает форму «Typizer: распознать документы».
//
// Параметры:
//  ПараметрыВыполненияКоманды - ПараметрыВыполненияКоманды, Неопределено - параметры команды, из которой открыта форма.
//  ВидДокумента - Строка - вид документа, выбранный по умолчанию (например, «СчетПоставщика» из списка счетов).
//
Процедура ОткрытьРаспознавание(ПараметрыВыполненияКоманды = Неопределено, ВидДокумента = "") Экспорт
	ПараметрыФормы = Новый Структура;
	Если Не ПустаяСтрока(ВидДокумента) Тогда
		ПараметрыФормы.Вставить("ВидДокумента", ВидДокумента);
	КонецЕсли;
	Если ПараметрыВыполненияКоманды = Неопределено Тогда
		ОткрытьФорму("Обработка.ТипизаторРаспознаваниеДокументов.Форма.Форма", ПараметрыФормы);
	Иначе
		ОткрытьФорму("Обработка.ТипизаторРаспознаваниеДокументов.Форма.Форма", ПараметрыФормы,
			ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно,
			ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	КонецЕсли;
КонецПроцедуры

// Открывает форму настроек подключения к Typizer.
//
// Параметры:
//  Владелец - ФормаКлиентскогоПриложения, Неопределено
//  ОповещениеОЗакрытии - ОписаниеОповещения, Неопределено
//
Процедура ОткрытьНастройки(Владелец = Неопределено, ОповещениеОЗакрытии = Неопределено) Экспорт
	ОткрытьФорму("Обработка.ТипизаторРаспознаваниеДокументов.Форма.ФормаНастроек", , Владелец, , , , ОповещениеОЗакрытии,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

#КонецОбласти
